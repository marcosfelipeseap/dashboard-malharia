<div class="slide-header">
  <div class="slide-title"><span class="material-icons">store</span> Raio X da Oficina</div>
  
  <div style="width: 300px; max-width: 100%; position: relative;">
    <div class="custom-dropdown" id="rxDropdown" style="width: 100%;">
        <div class="drop-btn" onclick="toggleRxDropdown()" style="height: 48px; border-radius: 14px !important;">
          <span id="rxSelectedText" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block; max-width:240px; font-weight: 700; color: var(--accent); text-transform: uppercase;">Selecione uma Oficina</span>
          <span class="material-icons" style="font-size:18px">arrow_drop_down</span>
        </div>
        <div class="dropdown-content" id="rxDropdownContent" style="width: 100%; right: 0; left: auto;">
          <div style="padding: 10px;">
              <input type="text" id="rxSearchInput" class="dropdown-search" placeholder="Pesquisar oficina..." onkeyup="filterRxOptions(event)" onclick="event.stopPropagation()">
          </div>
          <div id="rxOptionsContainer"></div>
        </div>
    </div>
    <input type="hidden" id="rxOficinaSelect" onchange="renderPageOficina()">
  </div>
</div>

<div id="rxWeekBanner" style="display: none; background: linear-gradient(135deg, var(--accent), var(--accent-dark)); color: white; border-radius: 20px; padding: 25px 30px; margin-bottom: 25px; flex-direction: column; gap: 20px; box-shadow: var(--shadow);">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; border-bottom: 1px solid rgba(255,255,255,0.2); padding-bottom: 20px;">
    <div style="display: flex; align-items: center; gap: 15px;">
      <button class="theme-btn" style="color:white; border-color:rgba(255,255,255,0.3); padding: 8px !important;" onclick="changeRxWeek(-1)" title="Semana Anterior"><span class="material-icons">chevron_left</span></button>
      <div style="text-align: center;">
        <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #90CAF9; margin-bottom: 2px;">Resumo Semanal</div>
        <div style="font-size: 1.5rem; font-weight: 800;" id="rxSemanaNum">--</div>
        <div style="font-size: 0.85rem; font-weight: 500;" id="rxSemanaDatas">-- a --</div>
      </div>
      <button class="theme-btn" style="color:white; border-color:rgba(255,255,255,0.3); padding: 8px !important;" onclick="changeRxWeek(1)" title="Próxima Semana"><span class="material-icons">chevron_right</span></button>
      
      <button class="theme-btn" style="margin-left: 15px; font-weight:700; color:white; background:#4CAF50; border:none;" onclick="generateSemanaRelatorio()"><i class="bi bi-whatsapp" style="margin-right: 5px;"></i> Relatório</button>
      
    </div>
    <div style="display: flex; gap: 15px; flex-wrap: wrap;">
      <div style="display: flex; flex-direction: column; align-items: center; background: rgba(255,255,255,0.15); padding: 12px 20px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1);">
        <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; margin-bottom: 5px;">Produção</div>
        <div style="font-size: 1.5rem; font-weight: 800;" id="rxWeekProd">0</div>
      </div>
      <div style="display: flex; flex-direction: column; align-items: center; background: rgba(255,255,255,0.15); padding: 12px 20px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1);">
        <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; margin-bottom: 5px;">Meta</div>
        <div style="font-size: 1.5rem; font-weight: 800;" id="rxWeekMeta">0</div>
      </div>
      <div style="display: flex; flex-direction: column; align-items: center; background: rgba(255,255,255,0.15); padding: 12px 20px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1);">
        <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; margin-bottom: 5px;">Performance</div>
        <div style="font-size: 1.5rem; font-weight: 800;" id="rxWeekPerf">0%</div>
      </div>
      <div style="display: flex; flex-direction: column; align-items: center; background: rgba(255,255,255,0.15); padding: 12px 20px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1);">
        <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; margin-bottom: 5px;">Dias</div>
        <div style="font-size: 1.5rem; font-weight: 800;" id="rxWeekDays">0</div>
      </div>
    </div>
  </div>
  
  <div id="rxWeekDaysGrid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px;">
  </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 25px;">
  <div class="chart-card" style="border-bottom: 5px solid #1E88E5; padding: 25px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
    <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 800; margin-bottom: 8px; letter-spacing: 0.5px;">Produção Acumulada</div>
    <div style="font-size: 2rem; font-weight: 800; color: var(--accent); line-height: 1.1;" id="rxTotalProd">0</div>
    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 5px; font-weight: 600;">Peças finalizadas</div>
  </div>
  
  <div class="chart-card" style="border-bottom: 5px solid #8E24AA; padding: 25px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
    <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 800; margin-bottom: 8px; letter-spacing: 0.5px;">Performance Global</div>
    <div style="font-size: 2rem; font-weight: 800; color: var(--accent); line-height: 1.1;" id="rxPerfGeral">0%</div>
    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 5px; font-weight: 600;">Produção vs Meta Total</div>
  </div>

  <div class="chart-card" style="border-bottom: 5px solid #43A047; padding: 25px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
    <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 800; margin-bottom: 8px; letter-spacing: 0.5px;">Média de Produção Diária</div>
    <div style="font-size: 2rem; font-weight: 800; color: var(--accent); line-height: 1.1;" id="rxAvgProd">0</div>
    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 5px; font-weight: 600;">Quantidade de peças por dia</div>
  </div>

  <div class="chart-card" style="border-bottom: 5px solid #00ACC1; padding: 25px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
    <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 800; margin-bottom: 8px; letter-spacing: 0.5px;">Capacidade (Mão de Obra)</div>
    <div style="font-size: 2rem; font-weight: 800; color: var(--accent); line-height: 1.1;" id="rxIntVinc">0</div>
    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 5px; font-weight: 600;"><span id="rxIntRemun" style="font-weight:800; color:var(--text-main)">0</span> Internos Remunerados</div>
  </div>
</div>

<div class="chart-card" style="height: 350px; padding: 25px; margin-bottom: 25px;">
  <canvas id="rxChart"></canvas>
</div>

<div class="chart-card" style="padding: 0; overflow: hidden; margin-top: 20px;">
  <div style="display: flex; justify-content: space-between; align-items: center; padding: 20px 25px; border-bottom: 1px solid var(--border-color); background: var(--card-bg); flex-wrap: wrap; gap: 15px;">
    <div>
        <span style="font-weight: 800; display: block; font-size: 1.1rem; text-transform: uppercase; color: var(--text-main);">Histórico Detalhado</span>
        <span style="font-size: 0.8rem; font-weight: 500; color: var(--text-muted); margin-top: 2px; display: block;">Acompanhamento diário da oficina, do mais recente para o mais antigo.</span>
    </div>
    <div>
        <input type="text" id="rxDateSearch" placeholder="🔍 Pesquisar por data (ex: 15/04), peça ou observação..." onkeyup="filterRxHistory()" style="width: 350px; max-width: 100%; padding: 12px 18px; border: 1px solid var(--border-color); border-radius: 12px; background: var(--input-bg); color: var(--text-main); font-size: 0.85rem; outline: none; transition: 0.2s;">
    </div>
  </div>
  <div style="max-height: 600px; overflow-y: auto;">
    <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
      <thead>
        <tr>
          <th style="background: var(--input-bg); color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; font-weight: 800; padding: 15px 20px; text-align: left; width: 140px; border-bottom: 1px solid var(--border-color);">Data e Status</th>
          <th style="background: var(--input-bg); color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; font-weight: 800; padding: 15px 20px; text-align: left; width: 180px; border-bottom: 1px solid var(--border-color);">Produção e Meta</th>
          <th style="background: var(--input-bg); color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; font-weight: 800; padding: 15px 20px; text-align: left; border-bottom: 1px solid var(--border-color);">Itens Produzidos</th>
          <th style="background: var(--input-bg); color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; font-weight: 800; padding: 15px 20px; text-align: center; width: 190px; border-bottom: 1px solid var(--border-color);">Mão de Obra</th>
          <th style="background: var(--input-bg); color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; font-weight: 800; padding: 15px 20px; text-align: left; width: 250px; border-bottom: 1px solid var(--border-color);">Observações</th>
        </tr>
      </thead>
      <tbody id="rxTableBody">
        <tr><td colspan="5" style="text-align:center; padding: 30px; color:var(--text-muted); font-weight:600;">Selecione uma oficina no topo da página.</td></tr>
      </tbody>
    </table>
  </div>
</div>

<script>
  let rxChartInst = null;
  let rxGlobalDaysMap = {}; 
  let currentSelectedWeekStart = null;
  let lastSelectedOficina = null;

  const diasDaSemanaNome = ['Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado', 'Domingo'];

  window.infoOficinasEstatico = window.infoOficinasEstatico || [];

  function initOficinaData() {
      if (document.getElementById('pageOficina').classList.contains('active')) renderPageOficina();
  }

  function getMonday(d) {
      d = new Date(d);
      let day = d.getDay();
      let diff = d.getDate() - day + (day === 0 ? -6 : 1);
      return new Date(d.setDate(diff));
  }

  function getWeekNumber(d) {
      let target = new Date(d.valueOf());
      let dayNr = (d.getDay() + 6) % 7;
      target.setDate(target.getDate() - dayNr + 3);
      let firstThursday = target.valueOf();
      target.setMonth(0, 1);
      if (target.getDay() !== 4) { target.setMonth(0, 1 + ((4 - target.getDay()) + 7) % 7); }
      return 1 + Math.ceil((firstThursday - target) / 604800000);
  }

  function generateSemanaRelatorio() {
      if (!currentSelectedWeekStart) return;

      let val = document.getElementById('rxOficinaSelect').value;
      let start = new Date(currentSelectedWeekStart);
      let end = new Date(start);
      end.setDate(end.getDate() + 6); // Até Domingo

      let weekNo = getWeekNumber(start);
      let fmt = date => String(date.getDate()).padStart(2,'0') + '/' + String(date.getMonth()+1).padStart(2,'0');
      let fmtFull = date => String(date.getDate()).padStart(2,'0') + '/' + String(date.getMonth()+1).padStart(2,'0') + '/' + date.getFullYear();
      
      let weekProd = 0;
      let weekMeta = 0;
      let weekDaysCount = 0;
      
      let daysText = '';

      for(let i=0; i<7; i++) {
          let currDate = new Date(start);
          currDate.setDate(currDate.getDate() + i);
          
          let dStr = fmtFull(currDate);
          let shortDate = fmt(currDate);
          let dayName = diasDaSemanaNome[i];
          let isWeekend = (i === 5 || i === 6); 

          daysText += `🗓 *${dayName} (${shortDate})*\n`;

          if (rxGlobalDaysMap[dStr]) {
              let inf = rxGlobalDaysMap[dStr];
              weekProd += inf.prod;
              
              let inRecess = (currDate.getTime() >= new Date(2025, 11, 23).getTime() && currDate.getTime() <= new Date(2026, 0, 2).getTime());
              if (!inRecess) { weekMeta += inf.meta; }
              weekDaysCount++;

              let bateu = inf.prod > 0 && inf.prod >= inf.meta;
              let isInsumo = inf.prod === 0 && inf.justs.some(j => typeof isSemInsumo === 'function' ? isSemInsumo(j) : false);

              let statusText = '❌ FALHA';
              if(bateu) statusText = '✅ OK';
              else if(isInsumo) statusText = '⚠️ S/I';

              let perc = inf.meta > 0 ? Math.round((inf.prod/inf.meta)*100) : (isInsumo ? 0 : 100);

              daysText += `Status: ${statusText} (${inf.prod} / ${inf.meta}) - ${perc}%\n`;
              
              inf.items.forEach(it => {
                  daysText += `- ${it.producaoDia}x ${it.item} (${it.tipo})\n`;
              });
              
              let uniqJ = [...new Set(inf.justs)].filter(j => j && j.trim() !== "");
              if(!bateu) {
                  if(uniqJ.length > 0) daysText += `Motivo: ${uniqJ.join(', ')}\n`;
                  else daysText += `Motivo: Não informado\n`;
              }
          } else {
              if (isWeekend) {
                  daysText += `Sem Expediente\n`;
              } else {
                  daysText += `⚪ Sem Relatório\n`;
              }
          }
          daysText += `\n`;
      }

      let weekPerf = weekMeta > 0 ? Math.round((weekProd / weekMeta) * 100) : (weekProd > 0 ? 100 : 0);

      let text = `*📊 RELATÓRIO SEMANAL - ${val}*\n`;
      text += `*Semana ${weekNo} (${fmt(start)} a ${fmt(end)})*\n\n`;
      
      text += `*Resumo da Semana:*\n`;
      text += `Produção: ${weekProd}\n`;
      text += `Meta: ${weekMeta}\n`;
      text += `Performance: ${weekPerf}%\n`;
      text += `Dias Trabalhados: ${weekDaysCount}\n\n`;

      text += `*--- DETALHES POR DIA ---*\n\n`;
      text += daysText;

      openWhatsModal(text.trim());
  }

  function setupRxDropdown(oficinas) {
      let optsContainer = document.getElementById('rxOptionsContainer');
      optsContainer.innerHTML = '';
      oficinas.forEach(of => {
          let optDiv = document.createElement('div');
          optDiv.className = 'check-item';
          optDiv.style.borderBottom = '1px dashed var(--border-color)';
          optDiv.style.fontWeight = '600';
          optDiv.innerText = of;
          optDiv.onclick = (e) => {
              e.stopPropagation();
              document.getElementById('rxSelectedText').innerText = of;
              document.getElementById('rxSelectedText').style.color = "var(--text-main)";
              document.getElementById('rxOficinaSelect').value = of;
              document.getElementById('rxDropdownContent').style.display = 'none';
              renderPageOficina();
          };
          optsContainer.appendChild(optDiv);
      });
  }

  function toggleRxDropdown() {
      let content = document.getElementById('rxDropdownContent');
      let isHidden = content.style.display === 'none' || content.style.display === '';
      if (isHidden) {
          content.style.display = 'flex';
          document.getElementById('rxSearchInput').value = '';
          filterRxOptions(); 
          setTimeout(() => document.getElementById('rxSearchInput').focus(), 50);
      } else {
          content.style.display = 'none';
      }
  }

  function filterRxOptions(e) {
      if (e) e.stopPropagation();
      let query = document.getElementById('rxSearchInput').value.toLowerCase();
      let opts = document.querySelectorAll('#rxOptionsContainer .check-item');
      opts.forEach(opt => {
          if (opt.innerText.toLowerCase().includes(query)) opt.style.display = 'block';
          else opt.style.display = 'none';
      });
  }

  document.addEventListener('click', function(event) {
      let dropdown = document.getElementById('rxDropdown');
      let content = document.getElementById('rxDropdownContent');
      if (dropdown && content && !dropdown.contains(event.target)) content.style.display = 'none';
  });

  function filterRxHistory() {
      let query = document.getElementById('rxDateSearch').value.toLowerCase();
      let rows = document.querySelectorAll('#rxTableBody tr');
      rows.forEach(r => {
          if (r.innerText.toLowerCase().includes(query)) r.style.display = '';
          else r.style.display = 'none';
      });
  }

  function changeRxWeek(offset) {
      if (!currentSelectedWeekStart) return;
      currentSelectedWeekStart.setDate(currentSelectedWeekStart.getDate() + (offset * 7));
      renderWeeklyBanner();
  }

  function renderWeeklyBanner() {
      if (!currentSelectedWeekStart) {
          document.getElementById('rxWeekBanner').style.display = 'none';
          return;
      }

      document.getElementById('rxWeekBanner').style.display = 'flex';

      let start = new Date(currentSelectedWeekStart);
      let end = new Date(start);
      end.setDate(end.getDate() + 6); // Até Domingo

      let weekNo = getWeekNumber(start);
      let fmt = date => String(date.getDate()).padStart(2,'0') + '/' + String(date.getMonth()+1).padStart(2,'0');
      
      document.getElementById('rxSemanaNum').innerText = 'Semana ' + weekNo;
      document.getElementById('rxSemanaDatas').innerText = fmt(start) + ' a ' + fmt(end);

      let weekProd = 0;
      let weekMeta = 0;
      let weekDaysCount = 0;
      let weekDaysHtml = '';

      for(let i=0; i<7; i++) {
          let currDate = new Date(start);
          currDate.setDate(currDate.getDate() + i);
          
          let dStr = String(currDate.getDate()).padStart(2,'0') + '/' + String(currDate.getMonth()+1).padStart(2,'0') + '/' + currDate.getFullYear();
          let shortDate = String(currDate.getDate()).padStart(2,'0') + '/' + String(currDate.getMonth()+1).padStart(2,'0');
          let dayName = diasDaSemanaNome[i];
          let isWeekend = (i === 5 || i === 6); 

          if (rxGlobalDaysMap[dStr]) {
              let inf = rxGlobalDaysMap[dStr];
              weekProd += inf.prod;
              
              let inRecess = (currDate.getTime() >= new Date(2025, 11, 23).getTime() && currDate.getTime() <= new Date(2026, 0, 2).getTime());
              if (!inRecess) { weekMeta += inf.meta; }
              weekDaysCount++;

              let bateu = inf.prod > 0 && inf.prod >= inf.meta;
              let isInsumo = inf.prod === 0 && inf.justs.some(j => typeof isSemInsumo === 'function' ? isSemInsumo(j) : false);

              let statusBadge = '';
              if(bateu) statusBadge = '<span style="background:#4CAF50; color:white; padding:4px 8px; border-radius:6px; font-size:0.65rem; font-weight:800;">OK</span>';
              else if(isInsumo) statusBadge = '<span style="background:#FF9800; color:white; padding:4px 8px; border-radius:6px; font-size:0.65rem; font-weight:800;">S/I</span>';
              else statusBadge = '<span style="background:#EF5350; color:white; padding:4px 8px; border-radius:6px; font-size:0.65rem; font-weight:800;">FALHA</span>';

              let perc = inf.meta > 0 ? Math.round((inf.prod/inf.meta)*100) : (isInsumo ? 0 : 100);

              let itemsList = inf.items.map(it => `<div style="margin-bottom:3px; font-size:0.75rem;"><b>${it.producaoDia}x</b> <span style="opacity:0.9">${it.item}</span></div>`).join('');
              
              let justHtml = '';
              let uniqJ = [...new Set(inf.justs)].filter(j => j && j.trim() !== "");
              if(!bateu) {
                  let txtJust = uniqJ.length > 0 ? uniqJ.join(', ') : 'Não informado';
                  justHtml = `<div style="background: rgba(244, 67, 54, 0.25); padding: 6px 10px; border-radius: 8px; color: #FFCDD2; font-size: 0.7rem; border-left: 3px solid #EF5350; margin-top:5px;"><b style="color:white;">Motivo:</b> ${txtJust}</div>`;
              }

              weekDaysHtml += `
              <div style="background: rgba(0,0,0,0.2); border-radius: 12px; padding: 15px; display: flex; flex-direction: column; gap: 8px; border: 1px solid rgba(255,255,255,0.1); transition: 0.2s;">
                  <div style="display: flex; justify-content: space-between; align-items: center; font-weight: 800; font-size: 0.85rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 8px;">
                      <span>${dayName} <span style="opacity:0.6; font-size:0.65rem; font-weight:500;">${shortDate}</span></span>
                      ${statusBadge}
                  </div>
                  <div style="display: flex; justify-content: space-between; align-items: center;">
                      <span style="font-size:1.2rem; font-weight:800;">${inf.prod} <span style="font-size:0.75rem; font-weight:500; opacity:0.6;">/ ${inf.meta} m.</span></span>
                      <span style="font-weight:800; opacity:0.9; font-size: 0.9rem;">${perc}%</span>
                  </div>
                  <div style="opacity: 0.9; line-height: 1.4; margin-top:5px;">${itemsList}</div>
                  ${justHtml}
              </div>`;

          } else {
              if (isWeekend) {
                  weekDaysHtml += `
                  <div style="background: rgba(0,0,0,0.2); border-radius: 12px; padding: 15px; display: flex; flex-direction: column; gap: 8px; border: 1px dashed rgba(255,255,255,0.2); justify-content: center; align-items: center; text-align: center; opacity: 0.5;">
                      <div style="font-weight:800; margin-bottom:4px; font-size:0.85rem;">${dayName} <span style="opacity:0.6; font-size:0.65rem; font-weight:500;">${shortDate}</span></div>
                      <div style="opacity:0.8; font-style:italic; font-size:0.75rem;">Sem Expediente</div>
                  </div>`;
              } else {
                  weekDaysHtml += `
                  <div style="background: rgba(0,0,0,0.2); border-radius: 12px; padding: 15px; display: flex; flex-direction: column; gap: 8px; border: 1px dashed rgba(255,255,255,0.2); justify-content: center; align-items: center; text-align: center; opacity: 0.7;">
                      <div style="font-weight:800; margin-bottom:4px; font-size:0.85rem;">${dayName} <span style="opacity:0.6; font-size:0.65rem; font-weight:500;">${shortDate}</span></div>
                      <div style="opacity:0.8; font-style:italic; font-size:0.75rem;">Sem Relatório</div>
                  </div>`;
              }
          }
      }

      let weekPerf = weekMeta > 0 ? Math.round((weekProd / weekMeta) * 100) : (weekProd > 0 ? 100 : 0);

      document.getElementById('rxWeekProd').innerText = weekProd;
      document.getElementById('rxWeekMeta').innerText = weekMeta;
      document.getElementById('rxWeekPerf').innerText = weekPerf + '%';
      document.getElementById('rxWeekDays').innerText = weekDaysCount;
      document.getElementById('rxWeekDaysGrid').innerHTML = weekDaysHtml;
  }

  function renderPageOficina() {
      if (typeof rawData === 'undefined' || rawData.length === 0) return;

      let val = document.getElementById('rxOficinaSelect').value;
      
      if (!val) {
          let ofs = [...new Set(rawData.map(r => r.oficina))].sort();
          setupRxDropdown(ofs);
          val = ofs[0]; 
          document.getElementById('rxSelectedText').innerText = val;
          document.getElementById('rxSelectedText').style.color = "var(--text-main)";
          document.getElementById('rxOficinaSelect').value = val;
      }

      if (val !== lastSelectedOficina) {
          currentSelectedWeekStart = null;
          lastSelectedOficina = val;
      }

      let dates = getFilterDates();
      let filtered = rawData.filter(r => r.oficina === val && r.dateObj >= dates.start && r.dateObj <= dates.end);

      rxGlobalDaysMap = {};
      filtered.forEach(r => {
          if (!rxGlobalDaysMap[r.data]) {
              rxGlobalDaysMap[r.data] = { prod: 0, intVinc: r.internosVinc, intProd: r.internos, items: [], justs: [] };
          }
          rxGlobalDaysMap[r.data].prod += r.producaoDia;
          rxGlobalDaysMap[r.data].items.push(r);
          if (r.justificativa) rxGlobalDaysMap[r.data].justs.push(r.justificativa);
          rxGlobalDaysMap[r.data].intVinc = Math.max(rxGlobalDaysMap[r.data].intVinc, r.internosVinc);
          rxGlobalDaysMap[r.data].intProd = Math.max(rxGlobalDaysMap[r.data].intProd, r.internos);
      });

      let dateKeys = Object.keys(rxGlobalDaysMap).sort((a,b) => {
         let da=a.split('/'), db=b.split('/');
         return new Date(da[2],da[1]-1,da[0]) - new Date(db[2],db[1]-1,db[0]);
      });

      if (!currentSelectedWeekStart && dateKeys.length > 0) {
          let latestDate = dateKeys[dateKeys.length - 1];
          let pts = latestDate.split('/');
          currentSelectedWeekStart = getMonday(new Date(pts[2], pts[1]-1, pts[0]));
      }

      renderWeeklyBanner();

      let totalProd = 0;
      let totalGlobalMeta = 0;
      let daysCount = dateKeys.length;
      let latestIntVinc = 0;

      if (daysCount > 0) {
          latestIntVinc = rxGlobalDaysMap[dateKeys[daysCount - 1]].intVinc;
      }

      let trs = '';
      let prodData = [];

      dateKeys.forEach(d => {
          let inf = rxGlobalDaysMap[d];
          let validItems = inf.items.filter(r => !(r.producaoDia === 0 && (typeof isSemInsumo === 'function' ? isSemInsumo(r.justificativa) : false)));
          inf.meta = validItems.length > 0 ? (typeof calculateDynamicMeta === 'function' ? calculateDynamicMeta(validItems) : 0) : 0;
          
          totalProd += inf.prod;
          
          let pts = d.split('/');
          let dTime = new Date(pts[2], pts[1]-1, pts[0]).getTime();
          let inRecess = (dTime >= new Date(2025, 11, 23).getTime() && dTime <= new Date(2026, 0, 2).getTime());
          if (!inRecess) { totalGlobalMeta += inf.meta; }

          prodData.push(inf.prod);
      });

      [...dateKeys].reverse().forEach(d => {
          let inf = rxGlobalDaysMap[d];
          
          let bateu = inf.prod > 0 && inf.prod >= inf.meta;
          let isInsumo = inf.prod === 0 && inf.justs.some(j => typeof isSemInsumo === 'function' ? isSemInsumo(j) : false);
          
          let statusText = 'INSUFICIENTE';
          let statusClass = 'fail';
          if(bateu) { statusText = 'SATISFATÓRIO'; statusClass = 'ok'; }
          else if(isInsumo) { statusText = 'SEM INSUMO'; statusClass = 'insumo'; }

          let perc = inf.meta > 0 ? Math.round((inf.prod / inf.meta) * 100) : (isInsumo ? 0 : 100);
          let percColor = bateu ? 'var(--success)' : (isInsumo ? 'var(--warning-text-dark)' : 'var(--danger)');

          let prodPorIntStr = inf.intProd > 0 ? (inf.prod / inf.intProd).toFixed(1).replace('.', ',') : '0,0';
          
          let itemsText = inf.items.map(i => `<div style="margin-bottom:6px; font-size:0.85rem;"><b>${i.producaoDia}x</b> ${i.item} <span style="color:var(--text-muted)">(${i.tipo})</span></div>`).join('');
          
          let uniqJ = [...new Set(inf.justs)].filter(j => j && j.trim() !== "");
          let justHtml = '';
          
          if (!bateu) {
              let txtJust = uniqJ.length > 0 ? uniqJ.join(', ') : 'Não informado';
              justHtml = `<div style="background: var(--danger-bg); border-left: 4px solid var(--danger); padding: 10px 15px; border-radius: 8px; font-size: 0.8rem; color: var(--danger);">
                            <span style="font-weight:700">Motivo:</span> ${txtJust}
                          </div>`;
          }

          trs += `<tr style="border-bottom: 1px dashed var(--border-color); transition: 0.2s;" onmouseover="this.style.background='var(--table-row-hover)'" onmouseout="this.style.background='transparent'">
            <td style="padding: 15px 20px; vertical-align: top;">
              <div style="font-size:0.95rem; font-weight:800; margin-bottom: 8px; color:var(--text-main);">${d}</div>
              <span class="pill ${statusClass}" style="display:inline-block; font-size:0.65rem; padding:5px 10px;">${statusText}</span>
            </td>
            <td style="padding: 15px 20px; vertical-align: top;">
              <div style="margin-bottom: 4px;">
                 <span style="font-size:1.6rem; font-weight:800; color:var(--primary); line-height:1;">${inf.prod}</span> 
                 <span style="font-size:0.85rem; color:var(--text-muted); font-weight:600;">/ ${inf.meta} (Meta)</span>
              </div>
              <div style="font-size:0.85rem; font-weight:700; color:${percColor};">${perc}% de Performance</div>
            </td>
            <td style="padding: 15px 20px; vertical-align: top; color: var(--text-main);">${itemsText}</td>
            <td style="text-align:center; padding: 15px 20px; vertical-align: top;">
              <div style="font-size:0.85rem; color:var(--text-muted); margin-bottom:6px; display:flex; flex-direction:column; gap:3px;">
                 <span>Vinculados: <b style="color:var(--text-main)">${inf.intVinc}</b></span>
                 <span>Produzindo: <b style="color:var(--primary)">${inf.intProd}</b></span>
              </div>
              <div style="font-size:0.75rem; background:var(--input-bg); padding:5px 10px; border-radius:8px; display:inline-block; border: 1px solid var(--border-color); margin-top:4px;">
                 <b style="font-size: 0.85rem; color:var(--text-main);">${prodPorIntStr}</b> <span style="color:var(--text-muted)">Peças por Interno</span>
              </div>
            </td>
            <td style="padding: 15px 20px; vertical-align: top;">${justHtml}</td>
          </tr>`;
      });

      let avgProd = daysCount ? Math.round(totalProd / daysCount) : 0;
      let globalPerf = totalGlobalMeta > 0 ? Math.round((totalProd / totalGlobalMeta) * 100) : 0;
      if (totalGlobalMeta === 0 && totalProd > 0) globalPerf = 100;
      
      let infoBase = window.infoOficinasEstatico.find(x => x.nome === val);
      let remunCount = infoBase ? infoBase.remunerados : '0';

      document.getElementById('rxTotalProd').innerText = totalProd;
      document.getElementById('rxPerfGeral').innerText = globalPerf + '%';
      document.getElementById('rxAvgProd').innerText = avgProd;
      document.getElementById('rxIntVinc').innerText = latestIntVinc;
      document.getElementById('rxIntRemun').innerText = remunCount;
      
      document.getElementById('rxTableBody').innerHTML = trs || '<tr><td colspan="5" style="text-align:center; padding: 30px; color:var(--text-muted); font-weight:600;">Nenhuma produção registrada neste período.</td></tr>';
      document.getElementById('rxDateSearch').value = '';

      if (rxChartInst) rxChartInst.destroy();
      if (!document.getElementById('pageOficina').classList.contains('active')) return;

      let ctx = document.getElementById('rxChart').getContext('2d');
      let gridColor = getComputedStyle(document.body).getPropertyValue('--chart-grid').trim();
      let txtColor = getComputedStyle(document.body).getPropertyValue('--text-muted').trim();
      let accent = getComputedStyle(document.body).getPropertyValue('--accent').trim();

      rxChartInst = new Chart(ctx, {
          type: 'bar',
          data: {
              labels: dateKeys,
              datasets: [{
                  label: 'Produção Diária',
                  data: prodData,
                  backgroundColor: accent,
                  borderRadius: 6,
                  datalabels: { color: 'white', font: {weight:'bold', family:'Poppins'}, anchor: 'end', align: 'top', offset: 2 }
              }]
          },
          options: {
              responsive: true, maintainAspectRatio: false,
              scales: {
                  x: { grid: {display:false}, ticks: {color: txtColor, font:{family:'Poppins', weight:'600'}} },
                  y: { beginAtZero: true, grid:{color: gridColor}, ticks: {color: txtColor, font:{family:'Poppins', weight:'600'}} }
              },
              plugins: { 
                  legend: { display: false },
                  title: { display: true, text: 'Volume de Produção Diário (Período Completo)', color: txtColor, align: 'start', font: {size: 14, weight: '700', family:'Poppins'}, padding:{bottom:20} }
              }
          }
      });
  }
</script>