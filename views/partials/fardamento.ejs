<style>
  .fardamento-container { display: flex; flex-direction: column; gap: 20px; }
  
  .filter-group { display: flex; flex-direction: column; gap: 4px; }
  .filter-group label { font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; }
  .filter-group input, .filter-group select { padding: 10px 14px; border: 1px solid var(--border-color); border-radius: 12px; background: var(--input-bg); color: var(--text-main); font-size: 0.85rem; font-family: 'Poppins', sans-serif; outline: none; cursor: pointer; transition: 0.2s;}
  .filter-group input:focus, .filter-group select:focus { border-color: var(--accent); }

  .highlight-total { background: linear-gradient(135deg, var(--accent), var(--accent-dark)); color: #ffffff; padding: 25px 30px; border-radius: 20px; display: flex; align-items: center; justify-content: space-between; box-shadow: var(--shadow); margin-bottom: 25px; flex-wrap: wrap; gap: 15px;}
  .highlight-total .ht-label { font-size: 1.1rem; font-weight: 700; text-transform: uppercase; opacity: 0.9; letter-spacing: 0.5px; }
  .highlight-total .ht-value { font-size: 2.5rem; font-weight: 800; display: flex; align-items: baseline; gap: 8px; }
  .highlight-total .ht-un { font-size: 1.2rem; font-weight: 600; opacity: 0.8; }

  .fardamento-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 15px; }
  
  .f-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 20px; padding: 20px; box-shadow: var(--shadow); display: flex; flex-direction: column; cursor: pointer; transition: 0.2s; position: relative; overflow: hidden; }
  .f-card:hover { transform: translateY(-3px); border-color: var(--accent); box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
  .f-card::after { content: 'Ver detalhes ➔'; position: absolute; bottom: 15px; right: 15px; font-size: 0.75rem; font-weight: 700; color: var(--accent); opacity: 0; transition: 0.2s; }
  .f-card:hover::after { opacity: 1; }

  .f-card-header { font-size: 0.85rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; border-bottom: 1px dashed var(--border-color); padding-bottom: 8px; }
  .f-card-val { font-size: 1.8rem; font-weight: 800; color: var(--accent); }
  .f-card-cor { font-size: 0.9rem; color: var(--text-main); font-weight: 600; }
  
  .fardamento-list { background: var(--card-bg); border-radius: 20px; box-shadow: var(--shadow); border: 1px solid var(--border-color); overflow-x: auto; }
  .f-table-header { display: grid; grid-template-columns: 120px 1fr 1fr 100px 1.5fr 1.5fr; background: var(--input-bg); padding: 15px 20px; font-weight: 700; font-size: 0.85rem; color: var(--text-muted); border-bottom: 1px solid var(--border-color); text-transform: uppercase; min-width: 800px;}
  
  .f-table-row { display: grid; grid-template-columns: 120px 1fr 1fr 100px 1.5fr 1.5fr; padding: 12px 20px; font-size: 0.85rem; border-bottom: 1px dashed var(--border-color); transition: 0.2s; align-items: center; color: var(--text-main); font-weight: 500; min-width: 800px;}
  .f-table-row:hover { background: var(--table-row-hover); }
  .f-table-row:last-child { border-bottom: none; }
  
  .f-empty { padding: 30px; text-align: center; color: var(--text-muted); font-style: italic; font-weight: 600;}

  .fard-view { animation: fadeEffect 0.3s ease; }

  .destinos-container { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 15px; }
  .dest-card { background: var(--input-bg); border: 1px solid var(--border-color); padding: 12px 18px; border-radius: 12px; display: flex; flex-direction: column; min-width: 140px; }
  .dest-name { font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dest-val { font-size: 1.2rem; font-weight: 800; color: var(--text-main); }
  
  .checkbox-wrapper { display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.85rem; color: var(--text-main); font-weight: 600; height: 100%; padding-top: 16px; }
  .checkbox-wrapper input { width: 18px; height: 18px; cursor: pointer; accent-color: var(--accent); }
</style>

<div class="fardamento-container">
  <div class="slide-header" id="fardHeader">
    <div class="slide-title">
      <span class="material-icons">checkroom</span> Fardamento Interno
    </div>
    
    <div style="display: flex; gap: 15px; flex-wrap: wrap; align-items: flex-start;">
      <div class="filter-group">
        <label>Início</label>
        <input type="date" id="fardStart" onchange="renderFardamento()">
      </div>
      <div class="filter-group">
        <label>Fim</label>
        <input type="date" id="fardEnd" onchange="renderFardamento()">
      </div>
      
      <div class="filter-group">
        <label>Produto</label>
        <select id="fardFilterTipo" onchange="renderFardamento()">
          <option value="">Todos</option>
        </select>
      </div>
      <div class="filter-group">
        <label>Cor</label>
        <select id="fardFilterCor" onchange="renderFardamento()">
          <option value="">Todas</option>
        </select>
      </div>

      <label class="checkbox-wrapper">
        <input type="checkbox" id="fardGroupByCor" checked onchange="renderFardamento()">
        Diferenciar por Cor
      </label>
    </div>
  </div>

  <div id="fardMainView" class="fard-view">
    
    <div class="highlight-total">
      <div>
        <div class="ht-label">Total de Peças Entregues</div>
        <div style="font-size: 0.85rem; opacity: 0.8; margin-top: 5px; font-weight: 500;">Baseado nos filtros selecionados</div>
      </div>
      <div class="ht-value">
        <span id="fardTotalGeralNum">0</span> 
        <span class="ht-un">peças</span>
      </div>
    </div>

    <h3 style="margin-bottom: 0; font-size: 1.2rem; font-weight: 800; color: var(--text-main); text-transform: uppercase;">Resumo por Tipo</h3>
    <div id="fardamentoCards" class="fardamento-cards" style="margin-top: 15px;"></div>

    <h3 style="margin-top: 30px; margin-bottom: 0; font-size: 1.2rem; font-weight: 800; color: var(--text-main); text-transform: uppercase;">Histórico Geral do Período</h3>
    <div class="fardamento-list" style="margin-top: 15px;">
      <div class="f-table-header">
        <div>Data</div>
        <div>Tipo</div>
        <div>Cor</div>
        <div style="text-align: center;">Qtd</div>
        <div>Destino</div>
        <div>Observação</div>
      </div>
      <div id="fardamentoTableBody"></div>
    </div>
  </div>

  <div id="fardDetailView" class="fard-view" style="display: none;">
    <button class="theme-btn" onclick="closeFardamentoDetails()" style="margin-bottom: 20px; font-weight: 700;">
      <span class="material-icons" style="font-size: 18px; margin-right: 5px;">arrow_back</span> Voltar ao Resumo
    </button>
    
    <div class="chart-card" style="padding: 25px; margin-bottom: 25px;">
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed var(--border-color); padding-bottom: 15px; flex-wrap: wrap; gap: 15px;">
        <div>
          <h2 id="fardDetailTitle" style="margin: 0; color: var(--accent); font-size: 1.4rem; font-weight: 800; text-transform: uppercase;"></h2>
          <div id="fardDetailSubtitle" style="font-size: 0.9rem; color: var(--text-muted); margin-top: 5px; font-weight: 500;"></div>
        </div>
        <div style="text-align: right;">
          <div style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Total Entregue</div>
          <div id="fardDetailTotal" style="font-size: 2rem; font-weight: 800; color: var(--accent);"></div>
        </div>
      </div>
      
      <div style="margin-top: 15px;">
        <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Subtotais por Destino</div>
        <div id="fardDetailDestinos" class="destinos-container"></div>
      </div>
    </div>

    <div class="fardamento-list">
      <div class="f-table-header">
        <div>Data</div>
        <div>Tipo</div>
        <div>Cor</div>
        <div style="text-align: center;">Qtd</div>
        <div>Destino</div>
        <div>Observação</div>
      </div>
      <div id="fardamentoDetailTableBody"></div>
    </div>
  </div>

</div>

<script>
  let rawFardamento = [];
  let currentPeriodData = []; 
  let isFardamentoLoaded = false;

  window.preloadFardamento = function(data) {
    if(data.error) { console.error(data.error); return; }
    
    rawFardamento = data.map(r => {
      let p = r.data.split('/');
      return { ...r, dateObj: new Date(p[2], p[1]-1, p[0]) };
    }).sort((a,b) => b.dateObj - a.dateObj); 
    
    isFardamentoLoaded = true;
    populateFilters();
    setupFardamentoDates();
  };

  function initFardamento() {
    if (isFardamentoLoaded) {
      closeFardamentoDetails(); 
      renderFardamento();
    }
  }

  function populateFilters() {
    let tipos = [...new Set(rawFardamento.map(r => r.tipo).filter(Boolean))].sort();
    let cores = [...new Set(rawFardamento.map(r => r.cor).filter(Boolean))].sort();

    let selectTipo = document.getElementById('fardFilterTipo');
    let selectCor = document.getElementById('fardFilterCor');

    selectTipo.innerHTML = '<option value="">Todos</option>';
    selectCor.innerHTML = '<option value="">Todas</option>';

    tipos.forEach(t => { selectTipo.innerHTML += `<option value="${t}">${t}</option>`; });
    cores.forEach(c => { selectCor.innerHTML += `<option value="${c}">${c}</option>`; });
  }

  function setupFardamentoDates() {
    let now = new Date();
    let firstDay = new Date(now.getFullYear(), 0, 1); 
    
    let toISO = d => {
      let m = String(d.getMonth() + 1).padStart(2, '0');
      let day = String(d.getDate()).padStart(2, '0');
      return `${d.getFullYear()}-${m}-${day}`;
    };
    
    document.getElementById('fardStart').value = toISO(firstDay);
    document.getElementById('fardEnd').value = toISO(now);
  }

  function renderFardamento() {
    closeFardamentoDetails();

    let startVal = document.getElementById('fardStart').value;
    let endVal = document.getElementById('fardEnd').value;
    let filterTipo = document.getElementById('fardFilterTipo').value;
    let filterCor = document.getElementById('fardFilterCor').value;
    let differentiateColor = document.getElementById('fardGroupByCor').checked;
    
    if(!startVal || !endVal) return;
    
    let sParts = startVal.split('-');
    let eParts = endVal.split('-');
    
    let start = new Date(sParts[0], sParts[1]-1, sParts[2]);
    let end = new Date(eParts[0], eParts[1]-1, eParts[2], 23, 59, 59); 

    currentPeriodData = rawFardamento.filter(r => {
      let inDate = r.dateObj >= start && r.dateObj <= end;
      let matchTipo = filterTipo === "" || r.tipo === filterTipo;
      let matchCor = filterCor === "" || r.cor === filterCor;
      return inDate && matchTipo && matchCor;
    });

    let cardsCont = document.getElementById('fardamentoCards');
    let tableCont = document.getElementById('fardamentoTableBody');
    let totalElement = document.getElementById('fardTotalGeralNum'); 
    
    cardsCont.innerHTML = '';
    tableCont.innerHTML = '';

    let totalGeralNoPeriodo = currentPeriodData.reduce((acc, curr) => acc + curr.quantidade, 0);
    totalElement.innerText = totalGeralNoPeriodo;

    if (currentPeriodData.length === 0) {
      cardsCont.innerHTML = '<div style="color:var(--text-muted); font-weight:600;">Sem entregas registradas para estes filtros.</div>';
      tableCont.innerHTML = '<div class="f-empty">Nenhum registro encontrado.</div>';
      return;
    }

    let groups = {};
    currentPeriodData.forEach(r => {
      let key = differentiateColor ? `${r.tipo} - ${r.cor}` : `${r.tipo}`;
      
      if (!groups[key]) {
        groups[key] = { 
          tipo: r.tipo, 
          cor: differentiateColor ? r.cor : 'Todas as Cores', 
          qtd: 0,
          filtroCor: differentiateColor ? r.cor : null 
        };
      }
      groups[key].qtd += r.quantidade;
    });

    Object.values(groups).sort((a,b) => b.qtd - a.qtd).forEach(g => {
      let card = document.createElement('div');
      card.className = 'f-card';
      card.onclick = () => showFardamentoDetails(g.tipo, g.filtroCor, g.qtd);
      card.innerHTML = `
        <div class="f-card-header">${g.tipo}</div>
        <div class="f-card-cor">Cor: <span style="font-weight:800">${g.cor}</span></div>
        <div style="margin-top: 10px;">
            <span class="f-card-val">${g.qtd}</span> <span style="font-size:0.8rem; font-weight:700; color:var(--text-muted)">un.</span>
        </div>
      `;
      cardsCont.appendChild(card);
    });

    let tableHtml = '';
    currentPeriodData.forEach(r => {
      tableHtml += `
        <div class="f-table-row">
          <div style="font-weight:700">${r.data}</div>
          <div>${r.tipo}</div>
          <div>${r.cor}</div>
          <div style="font-weight:800; color:var(--accent); text-align:center;">${r.quantidade}</div>
          <div style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="${r.destino}">${r.destino || '-'}</div>
          <div style="font-size:0.75rem; color:var(--text-muted); font-style:italic;">${r.observacao || '-'}</div>
        </div>
      `;
    });
    tableCont.innerHTML = tableHtml;
  }

  function showFardamentoDetails(tipo, cor, totalQtd) {
    document.getElementById('fardMainView').style.display = 'none';
    document.getElementById('fardDetailView').style.display = 'block';

    document.getElementById('fardDetailTitle').innerText = tipo;
    
    if(cor) {
      document.getElementById('fardDetailSubtitle').innerHTML = `Variação de Cor: <b>${cor}</b>`;
    } else {
      document.getElementById('fardDetailSubtitle').innerHTML = `<b>Todas as Cores</b> agrupadas`;
    }
    
    document.getElementById('fardDetailTotal').innerText = `${totalQtd} un.`;

    let detailData = currentPeriodData.filter(r => {
      if(cor) return r.tipo === tipo && r.cor === cor;
      return r.tipo === tipo;
    });
    
    let destinosGrp = {};
    detailData.forEach(r => {
      let dName = r.destino ? r.destino.trim() : 'NÃO INFORMADO';
      if(dName === '') dName = 'NÃO INFORMADO';
      if(!destinosGrp[dName]) destinosGrp[dName] = 0;
      destinosGrp[dName] += r.quantidade;
    });

    let destCont = document.getElementById('fardDetailDestinos');
    destCont.innerHTML = '';
    
    Object.keys(destinosGrp).sort((a,b) => destinosGrp[b] - destinosGrp[a]).forEach(destName => {
      let div = document.createElement('div');
      div.className = 'dest-card';
      div.innerHTML = `
        <div class="dest-name" title="${destName}">${destName}</div>
        <div class="dest-val">${destinosGrp[destName]} <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted);">un</span></div>
      `;
      destCont.appendChild(div);
    });

    let tableCont = document.getElementById('fardamentoDetailTableBody');
    let tableHtml = '';

    detailData.forEach(r => {
      tableHtml += `
        <div class="f-table-row">
          <div style="font-weight:700">${r.data}</div>
          <div>${r.tipo}</div>
          <div>${r.cor}</div>
          <div style="font-weight:800; color:var(--accent); text-align:center;">${r.quantidade}</div>
          <div style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="${r.destino}">${r.destino || '-'}</div>
          <div style="font-size:0.75rem; color:var(--text-muted); font-style:italic;">${r.observacao || '-'}</div>
        </div>
      `;
    });
    tableCont.innerHTML = tableHtml;
  }

  function closeFardamentoDetails() {
    document.getElementById('fardDetailView').style.display = 'none';
    document.getElementById('fardMainView').style.display = 'block';
  }
</script>