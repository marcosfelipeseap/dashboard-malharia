<style>
  .proc-table { width: 100%; border-collapse: collapse; background: var(--card-bg); font-size: 0.85rem; }
  .proc-table thead th {background: var(--accent) !important; color: white; padding: 15px; text-align: left; font-weight: 700; position: sticky; top: 0; z-index: 10; border: 1px solid var(--border-color); text-transform: uppercase; font-size: 0.75rem;}
  .proc-row { cursor: pointer; border-bottom: 1px solid var(--border-color); transition: background 0.2s; }
  .proc-row:hover { background-color: var(--table-row-hover); }
  .proc-row.expanded {background-color: var(--input-bg); border-left: 4px solid var(--accent);}
  .proc-table td { padding: 12px 15px; border-bottom: 1px solid var(--border-color); color: var(--text-main); vertical-align: middle; font-weight: 500; }
  .child-row { display: none; background: var(--bg-color); }
  .child-row.show { display: table-row; }
  
  .prod-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; margin: 15px; background: var(--card-bg); border-radius: 12px; overflow: hidden; border: 1px solid var(--border-color); box-shadow: var(--shadow);}
  .prod-table th { background: var(--input-bg); color: var(--text-muted); padding: 12px 15px; font-weight: 800; text-transform: uppercase; border-bottom: 1px solid var(--border-color); font-size: 0.75rem; text-align: left;}
  .prod-table td { padding: 12px 15px; border-bottom: 1px dashed var(--border-color); color: var(--text-main); font-weight: 500;}
</style>

<div class="slide-header">
  <div class="slide-title"><span class="material-icons">inventory_2</span> Controle de Processos</div>
  <div style="width: 100%; max-width: 400px; position: relative;">
    <span class="material-icons" style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 20px;">search</span>
    <input type="text" id="globalSearch" placeholder="Pesquisar por processo, órgão, produto ou observação..." onkeyup="handleGlobalSearch()" style="width:100%; padding: 12px 16px 12px 45px; border: 1px solid var(--border-color); border-radius: 12px; background: var(--input-bg); color: var(--text-main); font-size: 0.9rem; outline: none; transition: 0.2s;">
  </div>
</div>

<div style="display: flex; gap: 15px; flex-wrap: wrap; margin-bottom: 25px; align-items: center; width: 100%;">
  <div class="custom-dropdown" id="dd-nprocesso">
      <label style="font-size:0.75rem; font-weight:800; color:var(--text-muted); display:block; margin-bottom:5px; text-transform:uppercase;">Nº PROCESSO</label>
      <div class="drop-btn" onclick="toggleDropdown('list-nprocesso')">Selecionar... <span class="material-icons" style="font-size:18px">expand_more</span></div>
      <div id="list-nprocesso" class="dropdown-content"></div>
  </div>
  <div class="custom-dropdown" id="dd-demanda">
      <label style="font-size:0.75rem; font-weight:800; color:var(--text-muted); display:block; margin-bottom:5px; text-transform:uppercase;">TIPO DEMANDA</label>
      <div class="drop-btn" onclick="toggleDropdown('list-demanda')">Selecionar... <span class="material-icons" style="font-size:18px">expand_more</span></div>
      <div id="list-demanda" class="dropdown-content"></div>
  </div>
  <div class="custom-dropdown" id="dd-orgao">
      <label style="font-size:0.75rem; font-weight:800; color:var(--text-muted); display:block; margin-bottom:5px; text-transform:uppercase;">ÓRGÃO</label>
      <div class="drop-btn" onclick="toggleDropdown('list-orgao')">Selecionar... <span class="material-icons" style="font-size:18px">expand_more</span></div>
      <div id="list-orgao" class="dropdown-content"></div>
  </div>
  <div class="custom-dropdown" id="dd-produto">
      <label style="font-size:0.75rem; font-weight:800; color:var(--text-muted); display:block; margin-bottom:5px; text-transform:uppercase;">PRODUTO</label>
      <div class="drop-btn" onclick="toggleDropdown('list-produto')">Selecionar... <span class="material-icons" style="font-size:18px">expand_more</span></div>
      <div id="list-produto" class="dropdown-content"></div>
  </div>
  <div class="custom-dropdown" id="dd-status">
      <label style="font-size:0.75rem; font-weight:800; color:var(--text-muted); display:block; margin-bottom:5px; text-transform:uppercase;">STATUS</label>
      <div class="drop-btn" onclick="toggleDropdown('list-status')">Selecionar... <span class="material-icons" style="font-size:18px">expand_more</span></div>
      <div id="list-status" class="dropdown-content"></div>
  </div>
</div>

<div class="chart-card" style="padding: 0; overflow: hidden;">
  <div style="overflow-x: auto; max-height: 600px;">
    <table class="proc-table">
        <thead>
            <tr>
                <th style="width:30px"></th>
                <th>Nº PROCESSO</th>
                <th>TIPO DEMANDA</th>
                <th>ÓRGÃO</th>
                <th style="text-align: center;">TOTAL AUT.</th>
                <th style="text-align: center;">TOTAL ENTREGUE</th>
                <th style="text-align: center;">FALTANTE</th>
                <th style="text-align: center;">STATUS</th>
            </tr>
        </thead>
        <tbody id="processTableBody"></tbody>
    </table>
  </div>
</div>

<script>
  let processRawData = [];
  
  let p5Filters = { 
    nProcesso: [], 
    tipoDemanda: [], 
    orgao: [], 
    produto: [], 
    status: [],
    searchTerm: "" 
  };

  const filterMap = [
      { id: 'list-nprocesso', key: 'nProcesso' },
      { id: 'list-demanda', key: 'tipoDemanda' },
      { id: 'list-orgao', key: 'orgao' },
      { id: 'list-produto', key: 'produto' },
      { id: 'list-status', key: 'status' }
  ];

  function initProcesses(data) {
    if(data.error) { console.error(data.error); return; }
    processRawData = data;
    updateAllDropdowns();
    renderPage5();
  }

  function handleGlobalSearch() {
    p5Filters.searchTerm = document.getElementById('globalSearch').value.toLowerCase();
    renderPage5();
    updateAllDropdowns(); 
  }

  function toggleDropdown(id) {
    let el = document.getElementById(id);
    let wasShown = el.classList.contains('show');
    document.querySelectorAll('.dropdown-content').forEach(d => d.classList.remove('show'));
    if (!wasShown) {
        el.classList.add('show');
        let input = el.querySelector('.dropdown-search');
        if(input) setTimeout(() => input.focus(), 100);
    }
  }

  window.addEventListener('click', function(e) {
      if (!e.target.closest('.custom-dropdown')) {
          document.querySelectorAll('.dropdown-content').forEach(d => d.classList.remove('show'));
      }
  });

  function filterDropdownList(input) {
      let filter = input.value.toUpperCase();
      let container = input.nextElementSibling; 
      let items = container.getElementsByClassName('check-item');
      for (let i = 0; i < items.length; i++) {
          let txtValue = items[i].textContent || items[i].innerText;
          items[i].style.display = (txtValue.toUpperCase().indexOf(filter) > -1) ? "" : "none";
      }
  }

  function updateAllDropdowns() {
      filterMap.forEach(f => buildDropdown(f.id, f.key));
  }

  function buildDropdown(elementId, key) {
    let availableData = processRawData.filter(r => {
        if (p5Filters.searchTerm) {
            const searchStr = `${r.nProcesso} ${r.orgao} ${r.produto} ${r.tipoDemanda} ${r.obs}`.toLowerCase();
            if (!searchStr.includes(p5Filters.searchTerm)) return false;
        }
        for (let prop in p5Filters) {
            if (prop === key || prop === 'searchTerm') continue;
            if (p5Filters[prop].length > 0 && !p5Filters[prop].includes(r[prop])) return false;
        }
        return true;
    });

    let uniqueValues = [...new Set(availableData.map(r => r[key]))]
        .filter(v => v && v.toString().trim() !== '')
        .sort();

    let container = document.getElementById(elementId);
    let currentSearch = container.querySelector('.dropdown-search')?.value || '';

    container.innerHTML = '';
    
    let searchWrapper = document.createElement('div');
    searchWrapper.style.padding = '10px';
    searchWrapper.style.borderBottom = '1px solid var(--border-color)';
    let input = document.createElement('input');
    input.className = 'dropdown-search';
    input.placeholder = 'Pesquisar...';
    input.value = currentSearch;
    input.onkeyup = function() { filterDropdownList(this); };
    searchWrapper.appendChild(input);
    container.appendChild(searchWrapper);

    let listDiv = document.createElement('div');
    listDiv.style.maxHeight = '200px';
    listDiv.style.overflowY = 'auto';
    listDiv.style.padding = '5px 0';
    
    if(uniqueValues.length === 0) {
        listDiv.innerHTML = '<div style="padding:10px 15px; color:var(--text-muted); font-style:italic; font-size: 0.85rem;">Vazio</div>';
    } else {
        uniqueValues.forEach(val => {
            let isChecked = p5Filters[key].includes(val);
            let div = document.createElement('div');
            div.className = 'check-item';
            div.innerHTML = `<input type="checkbox" value="${val}" ${isChecked ? 'checked' : ''}> <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${val}</span>`;
            div.querySelector('input').onchange = function() { updateProcessFilters(key, this); };
            div.onclick = function(e) {
                if(e.target.tagName !== 'INPUT') {
                    let chk = this.querySelector('input');
                    chk.checked = !chk.checked;
                    updateProcessFilters(key, chk);
                }
            };
            listDiv.appendChild(div);
        });
    }
    container.appendChild(listDiv);
    if(currentSearch) filterDropdownList(input);
  }

  function updateProcessFilters(key, el) {
    if (el.checked) p5Filters[key].push(el.value);
    else p5Filters[key] = p5Filters[key].filter(v => v !== el.value);
    
    renderPage5();
    let openDropdownId = document.querySelector('.dropdown-content.show')?.id;
    updateAllDropdowns();
    if(openDropdownId) {
        document.getElementById(openDropdownId).classList.add('show');
        let input = document.getElementById(openDropdownId).querySelector('.dropdown-search');
        if(input) { input.focus(); let val = input.value; input.value = ''; input.value = val; }
    }
  }

  function renderPage5() {
    let tbody = document.getElementById('processTableBody');
    tbody.innerHTML = '';

    let filtered = processRawData.filter(r => {
        if (p5Filters.searchTerm) {
            const searchStr = `${r.nProcesso} ${r.orgao} ${r.produto} ${r.tipoDemanda} ${r.obs} ${r.situacao}`.toLowerCase();
            if (!searchStr.includes(p5Filters.searchTerm)) return false;
        }
        if (p5Filters.nProcesso.length && !p5Filters.nProcesso.includes(r.nProcesso)) return false;
        if (p5Filters.tipoDemanda.length && !p5Filters.tipoDemanda.includes(r.tipoDemanda)) return false;
        if (p5Filters.orgao.length && !p5Filters.orgao.includes(r.orgao)) return false;
        if (p5Filters.produto.length && !p5Filters.produto.includes(r.produto)) return false;
        if (p5Filters.status.length && !p5Filters.status.includes(r.status)) return false;
        return true;
    });

    let groups = {};
    
    const statusPriority = { 
        "Entrega não iniciada": 1, 
        "Parcialmente entregue": 2, 
        "Demanda concluída": 3 
    };

    filtered.forEach(r => {
        if (!groups[r.nProcesso]) {
            groups[r.nProcesso] = {
                nProcesso: r.nProcesso,
                linkSei: r.linkSei, 
                tipoDemanda: r.tipoDemanda, 
                orgao: r.orgao,
                status: r.status,
                items: [], 
                totalAutorizado: 0, 
                totalEntregue: 0, 
                totalFaltante: 0
            };
        } else {
            let currentStatusPrio = statusPriority[groups[r.nProcesso].status] || 99;
            let rowStatusPrio = statusPriority[r.status] || 99;
            if (rowStatusPrio < currentStatusPrio) {
                groups[r.nProcesso].status = r.status;
            }
        }
        
        groups[r.nProcesso].items.push(r);
        groups[r.nProcesso].totalAutorizado += r.qtdAutorizada || 0;
        groups[r.nProcesso].totalEntregue += r.qtdEntregue || 0;
        groups[r.nProcesso].totalFaltante += r.qtdFaltante || 0;
    });

    let groupArray = Object.values(groups);
    
    groupArray.sort((a, b) => (statusPriority[a.status] || 99) - (statusPriority[b.status] || 99));

    if (groupArray.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; padding:30px; color:var(--text-muted); font-weight: 600;">Nenhum processo encontrado com esses filtros.</td></tr>';
        return;
    }

    groupArray.forEach((g, idx) => {
        let rowId = 'proc-' + idx;
        let stClass = 'neutral';
        if (g.status === 'Demanda concluída') stClass = 'ok';
        else if (g.status === 'Parcialmente entregue') stClass = 'warn';
        else if (g.status === 'Entrega não iniciada') stClass = 'fail';

        let processoHtml = g.nProcesso;
        if (g.linkSei) {
            processoHtml = `<a href="${g.linkSei}" target="_blank" onclick="event.stopPropagation()" style="color:var(--accent); text-decoration:none; display:inline-flex; align-items:center; gap:3px;" title="Abrir processo no SEI">
                                ${g.nProcesso} <span class="material-icons" style="font-size:16px">open_in_new</span>
                            </a>`;
        }

        let tr = document.createElement('tr');
        tr.className = 'proc-row';
        tr.onclick = function() { toggleRow(this, rowId); };
        tr.innerHTML = `
            <td style="text-align:center"><span class="material-icons" style="font-size:18px; color:var(--text-muted)">expand_more</span></td>
            <td><strong style="color:var(--accent);">${processoHtml}</strong></td>
            <td>${g.tipoDemanda}</td>
            <td>${g.orgao}</td>
            <td style="font-weight:800; text-align:center; font-size:1.1rem;">${g.totalAutorizado}</td>
            <td style="color:var(--success); font-weight:800; text-align:center; font-size:1.1rem;">${g.totalEntregue}</td>
            <td style="color:var(--danger); font-weight:800; text-align:center; font-size:1.1rem;">${g.totalFaltante}</td>
            <td style="text-align:center;"><span class="st-badge ${stClass}">${g.status}</span></td>
        `;
        tbody.appendChild(tr);

        let trChild = document.createElement('tr');
        trChild.id = rowId;
        trChild.className = 'child-row';
        let childHtml = `<div style="padding: 15px 25px;"><table class="prod-table"><thead><tr>
            <th>Produto</th><th>Data Entrada</th><th style="text-align:center;">Qtd. Solicitada</th><th style="text-align:center;">Qtd. Autorizada</th><th style="text-align:center;">Qtd. Entregue</th>
            <th style="color:var(--danger); text-align:center;">Qtd. Faltante</th><th>Prazo</th><th>Situação</th><th>Obs</th>
            </tr></thead><tbody>`;
        
        g.items.forEach(item => {
            childHtml += `<tr style="transition: 0.2s;" onmouseover="this.style.background='var(--input-bg)'" onmouseout="this.style.background='transparent'">
                <td style="font-weight:700;">${item.produto}</td><td>${item.dataEntrada}</td><td style="text-align:center; font-weight:700;">${item.qtdSolicitada}</td>
                <td style="text-align:center; font-weight:700;">${item.qtdAutorizada}</td><td style="text-align:center; font-weight:700; color:var(--success);">${item.qtdEntregue}</td>
                <td style="color:var(--danger); font-weight:800; text-align:center;">${item.qtdFaltante}</td>
                <td><span style="background:var(--input-bg); border:1px solid var(--border-color); padding:4px 8px; border-radius:6px; font-size:0.75rem; font-weight:700;">${item.prazo}</span></td><td style="font-size:0.75rem; text-transform:uppercase; font-weight:700;">${item.situacao || item.status}</td><td style="font-size:0.75rem; color:var(--text-muted); font-style:italic;">${item.obs}</td>
            </tr>`;
        });
        childHtml += `</tbody></table></div>`;
        trChild.innerHTML = `<td colspan="8" style="padding:0; border:none;">${childHtml}</td>`;
        tbody.appendChild(trChild);
    });
  }

  function toggleRow(row, childId) {
    let child = document.getElementById(childId);
    row.classList.toggle('expanded');
    child.classList.toggle('show');
    let icon = row.querySelector('.material-icons');
    icon.innerText = row.classList.contains('expanded') ? 'expand_less' : 'expand_more';
  }
</script>