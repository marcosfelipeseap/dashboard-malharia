<script>
  Chart.register(ChartDataLabels);
  let rawData = [];
  let activeCharts = [];
  let chartDemandaInst = null;
  let chartDetailsInst = null; 
  let selectedOficinas = [];
  let globalDemandas = []; 
  const daysOfWeek = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
  
  window.hasShownNotif = false;

  function isSemInsumo(just) {
      if (!just) return false;
      let txt = just.toLowerCase();
      return txt.includes('insumo') && (txt.includes('sem') || txt.includes('falta'));
  }

  function normalizeDemandaStr(str) {
      if(!str) return "";
      let s = str.toLowerCase().trim();
      s = s.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
      s = s.replace(/\s+/g, ' ');
      let words = s.split(' ').map(w => {
          if(w.length > 3) {
              if(w.endsWith('oes') || w.endsWith('aes')) return w.slice(0, -3) + 'ao';
              if(w.endsWith('ais')) return w.slice(0, -2) + 'al';
              if(w.endsWith('eis')) return w.slice(0, -2) + 'el';
              if(w.endsWith('ois')) return w.slice(0, -2) + 'ol';
              if(w.endsWith('uis')) return w.slice(0, -2) + 'ul';
              if(w.endsWith('res') || w.endsWith('zes')) return w.slice(0, -2);
              if(w.endsWith('s')) return w.slice(0, -1);
          }
          return w;
      });
      return words.join(' ');
  }

  function isDateWeekend(dateStr) {
      if (!dateStr) return false;
      let p = dateStr.split('/');
      if (p.length !== 3) return false;
      let day = new Date(p[2], p[1]-1, p[0]).getDay();
      return day === 0 || day === 6;
  }

  function calculateDynamicMeta(dayRecords) {
      if (!dayRecords || dayRecords.length === 0) return 0;
      if (dayRecords.length === 1) return dayRecords[0].metaOficina || 0;
      let maxMeta = Math.max(...dayRecords.map(r => r.metaOficina || 0));
      let effectiveMetas = dayRecords.map(r => {
          let m = r.metaOficina || 0;
          return m === 0 ? maxMeta : m;
      });
      let maxProd = -1;
      let metaDoMaisProduzido = 0;
      let reached25 = false;

      dayRecords.forEach((r, idx) => {
          let m = effectiveMetas[idx];
          if (r.producaoDia > maxProd) {
              maxProd = r.producaoDia;
              metaDoMaisProduzido = m;
          }
          if (r.producaoDia >= (0.25 * m)) {
              reached25 = true;
          }
      });
      if (reached25) {
          let sum = effectiveMetas.reduce((a, b) => a + b, 0);
          return Math.round(sum / effectiveMetas.length);
      } else {
          return metaDoMaisProduzido;
      }
  }

  window.onload = async function() {
    
    startClock();
    
    try {
        let data = INITIAL_DATA; 
        
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('refresh') === 'true') {
            document.getElementById('loader').style.display = 'flex';
            document.getElementById('loader').style.opacity = '1';
            const res = await fetch('/api/data');
            data = await res.json();
            window.history.replaceState({}, document.title, "/");
        }

        if (data.error) throw new Error(data.error);

        let sheetData = data.sheetData;
        window.globalScheduleData = data.scheduleData;
        window.globalProcessData = data.processData;
        window.globalFardData = data.fardData;
        window.globalFardSeapData = data.fardSeapData;
        window.infoOficinasEstatico = data.oficinasData;

        init(sheetData);
        buildNotifications(window.globalScheduleData);
        
        if (typeof initOficinaData === 'function') initOficinaData();
        if (typeof initProcesses === 'function') initProcesses(window.globalProcessData);
        if (typeof preloadFardamento === 'function') preloadFardamento(window.globalFardData);
        if (typeof preloadFardamentoSeap === 'function') preloadFardamentoSeap(window.globalFardSeapData);
        
        document.body.classList.add('loaded');
        
        if (!window.hasShownNotif) {
            openNotifications();
            window.hasShownNotif = true;
        }
    } catch (err) {
        console.error(err);
        alert("Erro ao processar dados do painel: " + err.message);
        document.body.classList.add('loaded');
    }
  };

  function init(data) {
    if(data.error) { return; } 

    let demandaMap = {};

    let mappedData = data.map(r => {
      let p = r.data.split('/');
      let dateObj = new Date(p[2], p[1]-1, p[0]);
      let normItem = normalizeDemandaStr(r.item);
      
      if (!demandaMap[normItem] && r.item) {
          demandaMap[normItem] = r.item;
      }
      return { ...r, dateObj: dateObj, normItem: normItem };
    });

    rawData = mappedData.map(r => {
        if (r.normItem && demandaMap[r.normItem]) {
            r.item = demandaMap[r.normItem]; 
        }
        return r;
    }).sort((a,b) => a.dateObj - b.dateObj);

    let times = rawData.map(r => r.dateObj.getTime());
    let maxDate = new Date(Math.max(...times));
    let threeMonthsAgo = new Date(maxDate);
    threeMonthsAgo.setMonth(maxDate.getMonth() - 3);
    let toISO = d => d.toISOString().split('T')[0];
    
    document.getElementById('globalStart').value = toISO(threeMonthsAgo);
    document.getElementById('globalEnd').value = toISO(maxDate);
    document.getElementById('dailyDate').value = toISO(maxDate);

    setupChips();
    setupDemanda(); 
    renderPage1();
  }

  function getStartAndEndOfWeek() {
      let today = new Date();
      today.setHours(0, 0, 0, 0);
      let dayOfWeek = today.getDay(); 
      let start = new Date(today.getTime());
      start.setDate(today.getDate() - dayOfWeek); 
      let end = new Date(today.getTime());
      end.setDate(today.getDate() + (6 - dayOfWeek)); 
      end.setHours(23, 59, 59, 999);
      return { start, end };
  }

  function buildNotifications(scheduleGroups) {
      if(scheduleGroups.error) {
          console.error("Erro ao carregar notificações: ", scheduleGroups.error);
          return;
      }

      const diasSemana = ['Domingo', 'Segunda-feira', 'Terça-feira', 'Quarta-feira', 'Quinta-feira', 'Sexta-feira', 'Sábado'];
      let { start, end } = getStartAndEndOfWeek();

      let pendingThisWeek = scheduleGroups.filter(g => {
          if(g.totalPendente <= 0) return false;
          if(!g.prazo) return false;
          let dParts = g.prazo.split('/');
          if(dParts.length !== 3) return false;
          
          let prevDate = new Date(dParts[2], dParts[1]-1, dParts[0], 12, 0, 0);
          g._parsedDate = prevDate;
          g._nomeDia = diasSemana[prevDate.getDay()];

          return prevDate >= start && prevDate <= end;
      });

      pendingThisWeek.sort((a,b) => a._parsedDate - b._parsedDate);

      let notifHtml = '';
      let whatsappText = '*⚠️ ENTREGAS PENDENTES DA SEMANA* 📅\n\n';

      if(pendingThisWeek.length === 0) {
          notifHtml = '<div style="text-align: center; padding: 30px; color: var(--text-muted);"><span class="material-icons" style="font-size: 48px; color: var(--success); display: block; margin-bottom: 15px;">check_circle</span>Nenhuma entrega pendente para esta semana! 🎉</div>';
          whatsappText += 'Nenhuma entrega pendente para esta semana! 🎉';
          document.getElementById('notifBadge').style.display = 'none';
      } else {
          let processGroupsSet = new Set(pendingThisWeek.map(i => i.nProcesso));
          let badge = document.getElementById('notifBadge');
          badge.innerText = processGroupsSet.size;
          badge.style.display = 'block';

          let collapseCounter = 0;

          pendingThisWeek.forEach(g => {
              let collapseId = "notif_col_" + collapseCounter;
              collapseCounter++;
              
              let sumUI = {};
              g.items.forEach(i => {
                  let nomeMob = i.produto.trim().toUpperCase();
                  if(!sumUI[nomeMob]) sumUI[nomeMob] = 0;
                  sumUI[nomeMob] += i.qtdPendente;
              });
              
              let uiItemsHtml = Object.keys(sumUI).map(nome => {
                  return `<li><span style="font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 70%;">${nome}</span> <span class="st-badge warn">${sumUI[nome]} pendentes</span></li>`;
              }).join('');
              
              let prevFormatada = `${g.prazo} (${g._nomeDia})`;

              notifHtml += `
              <div class="notif-item">
                  <div class="notif-item-header" onclick="toggleAccordion(this)">
                      <div class="header-row-1">
                          <strong style="color:var(--accent); font-size: 15px;">${g.orgao}</strong>
                          <span class="material-icons">expand_more</span>
                      </div>
                      <div class="header-row-2">
                          <span>Processo: <strong>${g.nProcesso || 'N/A'}</strong></span>
                          <span class="st-badge fail"><span class="material-icons" style="font-size: 12px; vertical-align: middle; margin-right: 3px;">event</span> ${prevFormatada}</span>
                      </div>
                  </div>
                  <div class="notif-item-body">
                      <ul class="notif-item-list">
                          ${uiItemsHtml}
                      </ul>
                  </div>
              </div>`;

              whatsappText += `🏢 *Órgão:* ${g.orgao}\n`;
              whatsappText += `📄 *Processo:* ${g.nProcesso || 'N/A'}\n`;
              whatsappText += `🗓 *Previsão:* ${prevFormatada}\n`;
              whatsappText += `*Itens Pendentes:*\n`;
              Object.keys(sumUI).forEach(nome => {
                  whatsappText += `- ${sumUI[nome]}x ${nome}\n`;
              });
              whatsappText += `\n------------------------\n\n`;
          });
      }

      document.getElementById('notifBody').innerHTML = notifHtml;
      document.getElementById('btnCopyNotif').setAttribute('data-text', whatsappText);
  }

  function toggleAccordion(headerEl) {
      headerEl.classList.toggle('expanded');
      let bodyEl = headerEl.nextElementSibling;
      bodyEl.classList.toggle('show');
  }

  function openNotifications() { document.getElementById('notifOverlay').style.display = 'flex'; }
  function closeNotifications() { document.getElementById('notifOverlay').style.display = 'none'; }

  function copyWhatsAppText() {
      const text = document.getElementById('btnCopyNotif').getAttribute('data-text');
      navigator.clipboard.writeText(text).then(() => {
          const btn = document.getElementById('btnCopyNotif');
          const origHtml = btn.innerHTML;
          btn.innerHTML = '<i class="bi bi-check-lg" style="font-size: 16px; margin-right: 6px;"></i> Copiado!';
          btn.classList.remove('btn-notif-pri');
          btn.style.background = 'var(--input-bg)';
          btn.style.color = '#4CAF50';
          btn.style.border = '1px solid #4CAF50';
          setTimeout(() => {
              btn.innerHTML = origHtml;
              btn.classList.add('btn-notif-pri');
              btn.style = '';
          }, 2500);
      });
  }

  function updateAll() {
    setupChips();
    let active = document.querySelector('.page.active').id;
    if(active !== 'page1' && active !== 'page5' && active !== 'page6' && active !== 'page7' && active !== 'page8') {
        let functionName = active.replace('page', 'renderPage');
        if (typeof window[functionName] === 'function') window[functionName]();
    }
    if(active === 'pageOficina' && typeof renderPageOficina === 'function') renderPageOficina();
    if(active === 'page5' && typeof renderPage5 === 'function') renderPage5();
    if(active === 'page6' && typeof initCronograma === 'function') initCronograma();
    if(active === 'page7' && typeof initFardamento === 'function') renderFardamento();
    if(active === 'page8' && typeof initFardamentoSeap === 'function') renderFardamentoSeap();
  }

  function openModal(title, items, isHtml = false) {
    document.getElementById('modalTitle').innerText = title;
    let list = document.getElementById('modalList');
    list.innerHTML = '';
    if(items.length === 0) {
        list.innerHTML = '<div style="color:var(--text-muted); font-style:italic">Nenhum dia encontrado.</div>';
    } else {
        items.forEach(i => {
            let div = document.createElement('div');
            div.className = 'modal-item';
            if (isHtml) div.innerHTML = i;
            else div.innerText = i;
            list.appendChild(div);
        });
    }
    document.getElementById('customModal').style.display = 'block';
  }

  function closeModal() { document.getElementById('customModal').style.display = 'none'; }

  function wrapText(str, maxChars) {
    if(!str) return [];
    let words = str.split(' ');
    let lines = [];
    let currentLine = words[0];
    for (let i = 1; i < words.length; i++) {
        if (currentLine.length + 1 + words[i].length <= maxChars) {
            currentLine += ' ' + words[i];
        } else {
            lines.push(currentLine);
            currentLine = words[i];
        }
    }
    lines.push(currentLine);
    return lines;
  }

  function getFilterDates() {
    let sVal = document.getElementById('globalStart').value;
    let eVal = document.getElementById('globalEnd').value;
    if(!sVal || !eVal) return { start: new Date(0), end: new Date(0) };
    let sParts = sVal.split('-');
    let eParts = eVal.split('-');
    let start = new Date(sParts[0], sParts[1]-1, sParts[2]);
    let end = new Date(eParts[0], eParts[1]-1, eParts[2]);
    return { start, end };
  }

  function getMissingBusinessDays(oficina, filterStart, filterEnd, dataRecords) {
      let oficinaRecords = dataRecords.filter(r => r.oficina === oficina);
      if (oficinaRecords.length === 0) return []; 
      let minRecordDate = oficinaRecords[0].dateObj; 
      let maxRecordDate = oficinaRecords[oficinaRecords.length - 1].dateObj;
      let startCounting = new Date(Math.max(filterStart.getTime(), minRecordDate.getTime()));
      let endCounting = filterEnd;
      if (oficina === "GALPÃO 3.1" || oficina === "GALPÃO 3.2") {
          endCounting = new Date(Math.min(filterEnd.getTime(), maxRecordDate.getTime()));
      }
      let missing = [];
      let curr = new Date(startCounting);
      let existingDates = new Set(oficinaRecords.map(r => r.data));
      while (curr <= endCounting) {
          let dayOfWeek = curr.getDay();
          if (dayOfWeek !== 0 && dayOfWeek !== 6) { 
              let d = String(curr.getDate()).padStart(2, '0');
              let m = String(curr.getMonth() + 1).padStart(2, '0');
              let y = curr.getFullYear();
              let dateStr = `${d}/${m}/${y}`;
              if (!existingDates.has(dateStr)) missing.push(`${dateStr} (${daysOfWeek[dayOfWeek]})`);
          }
          curr.setDate(curr.getDate() + 1);
      }
      return missing;
  }

  function openMissingDetailsModal(oficina, datesStrArr) {
      if (!datesStrArr || datesStrArr.length === 0) return;
      let parseDateStr = (str) => {
          let p = str.split(' ')[0].split('/');
          return new Date(p[2], p[1]-1, p[0]);
      };
      let streaks = [];
      let currentStreak = [datesStrArr[0]];
      for(let i=1; i<datesStrArr.length; i++) {
          let d1 = parseDateStr(datesStrArr[i-1]);
          let d2 = parseDateStr(datesStrArr[i]);
          let diffTime = Math.abs(d2 - d1);
          let diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));
          if (diffDays === 1 || (diffDays === 3 && d1.getDay() === 5 && d2.getDay() === 1)) {
              currentStreak.push(datesStrArr[i]);
          } else {
              streaks.push(currentStreak);
              currentStreak = [datesStrArr[i]];
          }
      }
      streaks.push(currentStreak);

      let formattedItems = [];
      streaks.forEach(streak => {
          if(streak.length === 1) {
              formattedItems.push(`
                  <div style="margin-bottom: 8px; border-left: 3px solid var(--text-muted); padding-left: 10px;">
                      <div style="font-weight: 600; color: var(--text-main);">Dia isolado</div>
                      <div style="font-size: 13px; color: var(--text-muted);">${streak[0]}</div>
                  </div>
              `);
          } else {
              let start = streak[0].split(' ')[0];
              let end = streak[streak.length - 1].split(' ')[0];
              let daysList = streak.map(s => s.split(' ')[0]).join(', ');
              formattedItems.push(`
                  <div style="margin-bottom: 8px; border-left: 3px solid var(--danger); padding-left: 10px;">
                      <div style="font-weight: 600; color: var(--text-main);">Período consecutivo: ${streak.length} dias</div>
                      <div style="font-size: 13px; color: var(--text-muted); margin-bottom: 4px;">De <b>${start}</b> até <b>${end}</b></div>
                      <div style="font-size: 12px; color: var(--text-muted); background: var(--input-bg); padding: 4px; border-radius: 4px;">Dias: ${daysList}</div>
                  </div>
              `);
          }
      });
      openModal(`Detalhamento Sem Relatório - ${oficina}`, formattedItems, true);
  }

  function getColorForPercentage(perc) {
      if (perc >= 70) {
          let factor = (perc - 70) / (100 - 70); 
          return interpolate( {r:56,g:142,b:60}, {r:76,g:175,b:80}, factor );
      } else if (perc >= 40) {
          let factor = (perc - 40) / (69 - 40);
          return interpolate( {r:251,g:192,b:45}, {r:255,g:238,b:88}, factor );
      } else {
          let factor = perc / 39;
          return interpolate( {r:183,g:28,b:28}, {r:239,g:83,b:80}, factor );
      }
  }

  function interpolate(c1, c2, factor) {
      let r = Math.round(c1.r + factor * (c2.r - c1.r));
      let g = Math.round(c1.g + factor * (c2.g - c1.g));
      let b = Math.round(c1.b + factor * (c2.b - c1.b));
      return `rgb(${r}, ${g}, ${b})`;
  }

  function generateDiarioRelatorio() {
      let val = document.getElementById('dailyDate').value;
      if(!val) return;
      let sDate = val.split('-').reverse().join('/');
      let data = rawData.filter(r => r.data === sDate);
      
      let allOficinas = [...new Set(rawData.map(r => r.oficina))].sort();
      let groups = {};
      data.forEach(r => {
        if(!groups[r.oficina]) groups[r.oficina] = { prod:0, justs:[], items:[] };
        groups[r.oficina].prod += r.producaoDia;
        if(r.justificativa) groups[r.oficina].justs.push(r.justificativa);
        groups[r.oficina].items.push(r);
      });

      let listOk = []; let listFail = []; let listInsumo = []; let listMissing = [];

      Object.keys(groups).forEach(of => {
          let g = groups[of];
          let validItems = g.items.filter(r => !(r.producaoDia === 0 && isSemInsumo(r.justificativa)));
          g.meta = validItems.length > 0 ? calculateDynamicMeta(validItems) : 0;
          let hasInsumoIssue = g.justs.some(j => isSemInsumo(j));

          if (g.prod > 0 && g.prod >= g.meta) listOk.push(of);
          else if (g.prod === 0 && hasInsumoIssue) listInsumo.push(of); 
          else listFail.push(of);
      });

      let selDateObj = new Date(val.split('-')[0], val.split('-')[1]-1, val.split('-')[2]);
      let isWeekendDay = selDateObj.getDay() === 0 || selDateObj.getDay() === 6;

      let presentOficinas = Object.keys(groups);
      let maxDates = {};
      rawData.forEach(r => {
          if (!maxDates[r.oficina] || r.dateObj > maxDates[r.oficina]) maxDates[r.oficina] = r.dateObj;
      });

      if (isWeekendDay) {
          listMissing = []; 
      } else {
          listMissing = allOficinas.filter(of => {
              if (presentOficinas.includes(of)) return false;
              if ((of === "GALPÃO 3.1" || of === "GALPÃO 3.2") && selDateObj > maxDates[of]) return false;
              return true;
          });
      }

      listOk.sort(); listInsumo.sort(); listFail.sort(); listMissing.sort();

      let text = `*📊 DIÁRIO DE PRODUÇÃO - ${sDate}*\n`;
      if(isWeekendDay) text += `*(Fim de Semana)*\n`;
      text += `\n*Resumo:*\n`;
      text += `✅ Satisfatório: ${listOk.length}\n`;
      text += `⚠️ Sem Insumo: ${listInsumo.length}\n`;
      text += `❌ Insuficiente: ${listFail.length}\n`;
      text += `⚪ Não Informado: ${listMissing.length}\n\n`;
      text += `*--- DETALHAMENTO ---*\n\n`;

      let presentSorted = [...listOk, ...listInsumo, ...listFail];
      presentSorted.forEach(of => {
        let g = groups[of];
        let bateu = g.prod > 0 && g.prod >= g.meta;
        let isInsumo = listInsumo.includes(of);

        let statusText = '❌ INSUFICIENTE';
        if(bateu) statusText = '✅ SATISFATÓRIO';
        else if(isInsumo) statusText = '⚠️ SEM INSUMO';

        let perc = g.meta > 0 ? Math.round((g.prod / g.meta) * 100) : (isInsumo ? 0 : 100);

        text += `🏢 *${of}*\n`;
        text += `Status: ${statusText}\n`;
        text += `Produção: ${g.prod} / Meta: ${g.meta} (${perc}%)\n`;
        
        g.items.forEach(i => {
            text += `- ${i.producaoDia}x ${i.item} (${i.tipo})\n`;
        });

        if(!bateu) {
            let uniqJ = [...new Set(g.justs)].filter(j => j && j.trim() !== "");
            if(uniqJ.length) text += `Motivo: ${uniqJ.join(', ')}\n`;
            else text += `Motivo: Não informado\n`;
        }
        text += `\n`;
      });

      if(listMissing.length > 0) {
          text += `*⚪ NÃO INFORMADOS:*\n`;
          listMissing.forEach(of => { text += `- ${of}\n`; });
      }
      openWhatsModal(text.trim());
  }

