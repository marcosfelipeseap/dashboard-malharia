  function setupChips() {
    let dates = getFilterDates();
    let filtered = rawData.filter(r => r.dateObj >= dates.start && r.dateObj <= dates.end);
    let cont = document.getElementById('oficinaChips');
    cont.innerHTML = '';
    let list = [...new Set(filtered.map(r => r.oficina))].sort();
    selectedOficinas = selectedOficinas.filter(o => list.includes(o));
    if(list.length === 0) { cont.innerHTML = '<span style="font-size:0.85rem; color:var(--text-muted); font-weight:600;">Nenhuma oficina neste período.</span>'; }
    list.forEach(of => {
      let c = document.createElement('div');
      c.className = 'pill neutral'; c.style.cursor = 'pointer'; c.style.border = '1px solid var(--border-color)'; c.style.fontSize = '0.75rem';
      if(selectedOficinas.includes(of)) {
          c.classList.remove('neutral'); c.style.background = 'var(--accent)'; c.style.color = '#fff'; c.style.borderColor = 'var(--accent)';
      }
      c.innerText = of;
      c.onclick = () => {
        if(selectedOficinas.includes(of)) { 
            selectedOficinas = selectedOficinas.filter(x => x !== of); 
            c.style.background = 'var(--input-bg)'; c.style.color = 'var(--text-muted)'; c.style.borderColor = 'var(--border-color)';
        } 
        else { 
            selectedOficinas.push(of); 
            c.style.background = 'var(--accent)'; c.style.color = '#fff'; c.style.borderColor = 'var(--accent)';
        }
        renderPage2();
      };
      cont.appendChild(c);
    });
    if(document.getElementById('page2').classList.contains('active')) renderPage2();
  }

  function renderPage2() {
    let area = document.getElementById('chartsArea'); area.innerHTML = ''; activeCharts = [];
    let datesFilter = getFilterDates();
    let filtered = rawData.filter(r => r.dateObj >= datesFilter.start && r.dateObj <= datesFilter.end);
    let dates = [...new Set(filtered.map(r => r.data))].sort((a,b) => { let da=a.split('/'), db=b.split('/'); return new Date(da[2],da[1]-1,da[0]) - new Date(db[2],db[1]-1,db[0]); });
    let displayOrder = selectedOficinas.slice().reverse();
    window.tempMissingData = {}; window.tempInsumoData = {}; 

    displayOrder.forEach((of, idx) => {
      let missingDates = getMissingBusinessDays(of, datesFilter.start, datesFilter.end, rawData);
      window.tempMissingData[of] = missingDates; 

      let dayRecords = filtered.filter(x => x.oficina === of);
      let insumoRecords = dayRecords.filter(r => isSemInsumo(r.justificativa) && r.producaoDia === 0);
      let insumoDatesSet = new Set(insumoRecords.map(r => `${r.data} (${daysOfWeek[r.dateObj.getDay()]})`));
      let insumoDaysList = [...insumoDatesSet];
      window.tempInsumoData[of] = insumoDaysList;

      let totalProd = dayRecords.reduce((a, b) => a + b.producaoDia, 0);
      
      let daysMap = {};
      dayRecords.forEach(r => { if(!daysMap[r.data]) daysMap[r.data] = []; daysMap[r.data].push(r); });
      
      let totalMeta = 0;
      Object.keys(daysMap).forEach(dateStr => {
          let rArr = daysMap[dateStr];
          let dObj = rArr[0].dateObj;
          let recessStart = new Date(2025, 11, 23); let recessEnd = new Date(2026, 0, 2);     
          if (dObj >= recessStart && dObj <= recessEnd) return;
          let validRecords = rArr.filter(r => !(r.producaoDia === 0 && isSemInsumo(r.justificativa)));
          if (validRecords.length > 0) totalMeta += calculateDynamicMeta(validRecords);
      });

      let perfPerc = totalMeta > 0 ? Math.round((totalProd/totalMeta)*100) : 0;
      if (totalMeta === 0 && totalProd > 0) perfPerc = 100; 
      let perfClass = perfPerc >= 75 ? 'ok' : 'fail';

      let refMetaRecord = filtered.find(r => r.oficina === of && r.metaOficina > 0);
      let refMeta = refMetaRecord ? refMetaRecord.metaOficina : 0;
      
      let div = document.createElement('div'); div.className = 'chart-card'; div.style.padding = '20px'; div.style.marginBottom = '20px';
      div.innerHTML = `
        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:15px; border-bottom:1px solid var(--border-color); padding-bottom:15px; flex-wrap:wrap; gap:15px;">
           <h3 style="margin:0; font-size:1.2rem; font-weight:800; color:var(--text-main); text-transform:uppercase;">${of}</h3>
           <div style="text-align: right; display: flex; flex-direction: column; gap: 8px; align-items: flex-end;">
               <div class="st-badge ${perfClass}">PERFORMANCE: ${perfPerc}%</div>
               ${missingDates.length > 0 ? `<div class="st-badge neutral" style="cursor:pointer; border:1px solid var(--border-color);" onclick="openModal('Relatórios não enviados - ${of}', window.tempMissingData['${of}'])">RELATÓRIOS NÃO ENVIADOS: ${missingDates.length} DIAS</div>` : '' }
               ${insumoDaysList.length > 0 ? `<div class="st-badge warn" style="cursor:pointer; border:1px solid var(--warning);" onclick="openModal('Dias sem Insumo (Prod: 0) - ${of}', window.tempInsumoData['${of}'])">DIAS SEM INSUMO (PROD ZERO): ${insumoDaysList.length} DIAS</div>` : '' }
           </div>
        </div>
        <div style="height:300px"><canvas></canvas></div>`;
      area.appendChild(div);

      let ofMaxDate = dayRecords.length > 0 ? new Date(Math.max(...dayRecords.map(r => r.dateObj.getTime()))) : new Date(0);

      let prodData = dates.map(d => {
         let pts = d.split('/'); let dObj = new Date(pts[2], pts[1]-1, pts[0]);
         if ((of === "GALPÃO 3.1" || of === "GALPÃO 3.2") && dObj > ofMaxDate) return null;
         let rs = filtered.filter(x => x.oficina === of && x.data === d);
         if (rs.length === 0 && isDateWeekend(d)) return null; 
         return rs.reduce((a,b)=>a+b.producaoDia,0) || 0;
      });
      
      let metaData = dates.map(d => {
         let pts = d.split('/'); let dObj = new Date(pts[2], pts[1]-1, pts[0]);
         if ((of === "GALPÃO 3.1" || of === "GALPÃO 3.2") && dObj > ofMaxDate) return null;
         let rs = filtered.filter(x => x.oficina === of && x.data === d);
         if (rs.length === 0 && isDateWeekend(d)) return null; 
         let valid = rs.filter(r => !(r.producaoDia === 0 && isSemInsumo(r.justificativa)));
         if(valid.length > 0) return calculateDynamicMeta(valid); 
         let allInsumo = rs.length > 0 && rs.every(r => r.producaoDia === 0 && isSemInsumo(r.justificativa));
         if (allInsumo) return 0;
         return refMeta;
      });

      let gridColor = getComputedStyle(document.body).getPropertyValue('--chart-grid').trim(); 
      let txtColor = getComputedStyle(document.body).getPropertyValue('--text-muted').trim();
      let accent = getComputedStyle(document.body).getPropertyValue('--accent').trim();
      let danger = getComputedStyle(document.body).getPropertyValue('--danger').trim();

      let ctx = div.querySelector('canvas');
      let chart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: dates,
          datasets: [
            {
              label: 'Produção', data: prodData, spanGaps: true, borderColor: accent, backgroundColor: accent,
              borderWidth: 3, pointRadius: 5, pointBackgroundColor: getComputedStyle(document.body).getPropertyValue('--card-bg').trim(), tension: 0.2,
              datalabels: { align:'top', backgroundColor:accent, borderRadius:4, color:'white', font:{weight:'bold'}, formatter: (val) => val === null ? '' : (val === 0 ? '0' : val) }
            },
            {
              label: 'Meta', data: metaData, spanGaps: true, borderColor: danger, borderWidth: 2, borderDash: [6,6], pointRadius: 0, datalabels: { display: false }
            }
          ]
        },
        options: {
          responsive:true, maintainAspectRatio:false,
          scales: { y: { beginAtZero:true, grid:{color:gridColor}, ticks:{color:txtColor, font:{family:'Poppins', weight:'600'}} }, x: { grid:{display:false}, ticks:{color:txtColor, font:{family:'Poppins', weight:'600'}} } },
          plugins: { 
            legend: { labels: { color: txtColor, font:{family:'Poppins', weight:'700'} } },
            tooltip: {
              titleFont: {family: 'Poppins', size: 14},
              bodyFont: {family: 'Poppins', size: 13},
              callbacks: {
                afterBody: function(tooltipItems) {
                  let idx = tooltipItems[0].dataIndex; let dateVal = dates[idx];
                  let dayRecords = filtered.filter(x => x.oficina === of && x.data === dateVal);
                  let totalProd = dayRecords.reduce((a, b) => a + b.producaoDia, 0);
                  let validRecords = dayRecords.filter(r => !(r.producaoDia === 0 && isSemInsumo(r.justificativa)));
                  let dayMeta = validRecords.length ? calculateDynamicMeta(validRecords) : refMeta;
                  
                  let finalLines = [];
                  if (totalProd > 0) dayRecords.forEach(r => { finalLines.push(...wrapText(`• ${r.item} (${r.tipo}): ${r.producaoDia}`, 50)); });
                  if (totalProd < dayMeta) {
                      let justs = [...new Set(dayRecords.map(r => r.justificativa).filter(j => j && j.trim() !== ""))];
                      if (justs.length > 0) justs.forEach(j => { finalLines.push(...wrapText(`• Motivo: ${j}`, 50)); }); 
                      else finalLines.push('• Motivo: Não informado');
                  }
                  return finalLines;
                }
              }
            }
          }
        }
      });
      activeCharts.push(chart);
    });
  }

  function renderPage3() {
    let dates = getFilterDates();
    let filtered = rawData.filter(r => r.dateObj >= dates.start && r.dateObj <= dates.end);
    
    let uniqueOficinasAll = [...new Set(filtered.map(r=>r.oficina))];
    let rankingData = [];
    window.tempMissingDataP3 = {}; 
    
    let fmtDate = d => d.getDate().toString().padStart(2,'0') + '/' + (d.getMonth()+1).toString().padStart(2,'0') + '/' + d.getFullYear();
    document.getElementById('rankingPeriodDisplay').innerText = `De ${fmtDate(dates.start)} até ${fmtDate(dates.end)}`;

    uniqueOficinasAll.forEach(of => {
        let dayRecords = filtered.filter(x => x.oficina === of);
        let totalProd = dayRecords.reduce((a, b) => a + b.producaoDia, 0);
        let daysMap = {};
        dayRecords.forEach(r => { if(!daysMap[r.data]) daysMap[r.data] = []; daysMap[r.data].push(r); });
        
        let totalMeta = 0;
        Object.keys(daysMap).forEach(dateStr => {
            let rArr = daysMap[dateStr];
            let dObj = rArr[0].dateObj;
            let recessStart = new Date(2025, 11, 23); let recessEnd = new Date(2026, 0, 2);     
            if (dObj >= recessStart && dObj <= recessEnd) return;
            let validRecords = rArr.filter(r => !(r.producaoDia === 0 && isSemInsumo(r.justificativa)));
            if (validRecords.length > 0) totalMeta += calculateDynamicMeta(validRecords);
        });

        let perc = totalMeta > 0 ? Math.round((totalProd/totalMeta)*100) : 0;
        if (totalMeta === 0 && totalProd > 0) perc = 100;
        rankingData.push({ name: of, perc: perc });
    });

    rankingData.sort((a,b) => b.perc - a.perc);

    let rankCont = document.getElementById('rankingList'); rankCont.innerHTML = '';
    if (rankingData.length === 0) rankCont.innerHTML = '<div style="color:var(--text-muted); font-weight:600;">Sem dados para ranking.</div>';
    else {
        rankingData.forEach((item, index) => {
            let color = getColorForPercentage(item.perc);
            let div = document.createElement('div');
            div.style.display = 'flex'; div.style.alignItems = 'center'; div.style.background = 'var(--input-bg)'; div.style.padding = '12px 18px'; div.style.borderRadius = '12px'; div.style.border = '1px solid var(--border-color)'; div.style.gap = '15px';
            div.innerHTML = `
                <div style="min-width: 40px; text-align: center; font-weight: 800; font-size: 1.2rem; color: var(--text-muted);">#${index+1}</div>
                <div style="flex: 1; display: flex; flex-direction: column; justify-content: center; overflow: hidden;">
                    <div style="font-weight: 700; font-size: 0.95rem; color: var(--text-main); margin-bottom: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${item.name}">${item.name}</div>
                    <div style="height: 8px; width: 100%; background: var(--border-color); border-radius: 4px; overflow: hidden;"><div style="height: 100%; border-radius: 4px; width:${Math.min(item.perc, 100)}%; background:${color}"></div></div>
                </div>
                <div style="font-size: 1.1rem; font-weight: 800; text-align: right; min-width: 50px; color: var(--text-main);">${item.perc}%</div>
            `;
            rankCont.appendChild(div);
        });
    }

    let missingRankingData = [];
    uniqueOficinasAll.forEach(of => {
        let missingDates = getMissingBusinessDays(of, dates.start, dates.end, rawData);
        window.tempMissingDataP3[of] = missingDates; 
        if(missingDates.length > 0) missingRankingData.push({ name: of, count: missingDates.length, dates: missingDates });
    });
    missingRankingData.sort((a,b) => b.count - a.count);

    let rankMissingCont = document.getElementById('rankingMissingList'); rankMissingCont.innerHTML = '';
    if (missingRankingData.length === 0) {
        rankMissingCont.innerHTML = '<div style="color:var(--text-muted); font-size: 0.9rem; font-weight: 600; padding: 10px;">Todas as malharias enviaram relatórios neste período.</div>';
    } else {
        let maxMissing = missingRankingData[0].count;
        missingRankingData.forEach((item, index) => {
            let widthPerc = (item.count / maxMissing) * 100;
            let div = document.createElement('div'); 
            div.style.display = 'flex'; div.style.alignItems = 'center'; div.style.background = 'var(--input-bg)'; div.style.padding = '12px 18px'; div.style.borderRadius = '12px'; div.style.border = '1px solid var(--border-color)'; div.style.gap = '15px'; div.style.cursor = 'pointer';
            div.title = "Clique para ver os detalhes dos dias não informados";
            div.onclick = () => openMissingDetailsModal(item.name, item.dates);
            div.innerHTML = `
                <div style="min-width: 40px; text-align: center; font-weight: 800; font-size: 1.2rem; color: var(--text-muted);">#${index+1}</div>
                <div style="flex: 1; display: flex; flex-direction: column; justify-content: center; overflow: hidden;">
                    <div style="font-weight: 700; font-size: 0.95rem; color: var(--text-main); margin-bottom: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${item.name}">${item.name}</div>
                    <div style="height: 8px; width: 100%; background: var(--border-color); border-radius: 4px; overflow: hidden;"><div style="height: 100%; border-radius: 4px; width:${widthPerc}%; background:var(--text-muted)"></div></div>
                </div>
                <div style="font-size: 1rem; font-weight: 800; text-align: right; min-width: 50px; color: var(--text-muted);">${item.count} dias</div>
            `;
            rankMissingCont.appendChild(div);
        });
    }

    let list = document.getElementById('detailedList'); list.innerHTML = '';
    let uniqueOficinas = [...new Set(filtered.map(r=>r.oficina))].sort();
    
    let chartHeight = Math.max(400, uniqueOficinas.length * 40);
    document.getElementById('chartDetailsContainer').style.height = chartHeight + 'px';

    let labels = []; let dataOk = []; let dataFail = [];

    uniqueOficinas.forEach(of => {
      let rs = filtered.filter(r => r.oficina === of);
      let days = {}; 
      rs.forEach(r => { 
        if(!days[r.data]) days[r.data]={p:0, items: [], j:[]}; 
        days[r.data].p += r.producaoDia; days[r.data].items.push(r);
        if(r.justificativa) days[r.data].j.push(r.justificativa);
      });
      
      let okCount = 0; let failCount = 0; let insumoZeroCount = 0;
      
      Object.keys(days).forEach(d => {
          let inf = days[d];
          let validItems = inf.items.filter(r => !(r.producaoDia === 0 && isSemInsumo(r.justificativa)));
          if (validItems.length > 0) inf.m = calculateDynamicMeta(validItems);
          else inf.m = 0; 
          
          let hasInsumoZero = inf.p === 0 && inf.j.some(just => isSemInsumo(just));
          if (hasInsumoZero) { insumoZeroCount++; return; }
          if(inf.p >= inf.m) okCount++; else failCount++;
      });

      labels.push(of); dataOk.push(okCount); dataFail.push(failCount);

      let tot = okCount + failCount;
      let pc = tot?Math.round((okCount/tot)*100):0;
      let missingDates = window.tempMissingDataP3[of] || [];

      let rows = '';
      Object.keys(days).sort((a,b)=>{let da=a.split('/'),db=b.split('/');return new Date(db[2],db[1]-1,db[0]) - new Date(da[2],da[1]-1,da[0])}).forEach(d=>{
        let pts = d.split('/'); let dayOfWeek = new Date(pts[2], pts[1]-1, pts[0]).getDay();
        let isWknd = dayOfWeek === 0 || dayOfWeek === 6;

        let inf=days[d]; 
        let isOk=inf.p>=inf.m;
        let hasInsumoZero = inf.p === 0 && inf.j.some(just => isSemInsumo(just));
        let statusText = isOk ? 'OK' : 'FALHA';
        let statusColor = isOk ? 'var(--success)' : 'var(--danger)';

        if (hasInsumoZero) { statusText = 'S/ INSUMO'; statusColor = 'var(--warning-text-dark)'; }
        let dLabel = d;
        if (isWknd) dLabel += ` <span style="font-size:0.65rem; color:var(--warning-text-dark); font-weight:800;">(${daysOfWeek[dayOfWeek]})</span>`;

        let uniqJ = [...new Set(inf.j)].filter(j => j && j.trim() !== "");
        let justNote = '';
        if (!isOk) {
            justNote = `<div style="font-size:0.75rem; color:var(--danger); background:var(--danger-bg); padding:6px 12px; border-radius:6px; margin-top:5px; font-weight:600;">Motivo: ${uniqJ.length > 0 ? uniqJ.join(', ') : 'Não informado'}</div>`;
        }
        
        rows += `<div style="display:flex; justify-content:space-between; padding:12px 0; border-bottom:1px dashed var(--border-color); font-size:0.85rem;"><span style="width:110px; font-weight:600;">${dLabel}</span><span style="flex:1; text-align:center; font-weight:700;">${inf.p} <span style="color:var(--text-muted); font-size:0.75rem;">/ ${inf.m}</span></span><span style="font-weight:800; color:${statusColor}">${statusText}</span></div>${justNote}`;
      });
      
      let el = document.createElement('div'); el.className='chart-card'; el.style.padding='0'; el.style.marginBottom='15px'; el.style.overflow='hidden';
      el.innerHTML=`
        <div style="padding:15px 20px; cursor:pointer; display:flex; justify-content:space-between; align-items:center; transition:0.2s; background:var(--input-bg); border-bottom:1px solid var(--border-color);" onclick="this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'block' ? 'none' : 'block'">
           <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
              <span style="font-weight:800; color:var(--accent); font-size:1.1rem; text-transform:uppercase;">${of}</span>
              ${missingDates.length > 0 ? `<span class="st-badge neutral" style="border:1px solid var(--border-color);" onclick="event.stopPropagation(); openMissingDetailsModal('${of}', window.tempMissingDataP3['${of}'])">SR: ${missingDates.length} dias</span>` : ''}
              ${insumoZeroCount > 0 ? `<span class="st-badge warn" title="Dias com produção 0 devido à falta de insumos">S/I: ${insumoZeroCount} dias</span>` : ''}
           </div>
           <span style="font-weight:700; color:var(--text-muted); font-size:0.9rem;">${okCount}/${tot} Dias (${pc}%)</span>
        </div>
        <div style="display:none; padding:20px;">${rows}</div>`;
      list.appendChild(el);
    });

    if(chartDetailsInst) chartDetailsInst.destroy();
    let ctx = document.getElementById('chartDetails').getContext('2d');
    let txtColor = getComputedStyle(document.body).getPropertyValue('--text-muted').trim(); 
    let gridColor = getComputedStyle(document.body).getPropertyValue('--chart-grid').trim();

    chartDetailsInst = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Satisfatório', data: dataOk, backgroundColor: '#2E7D32', barPercentage: 0.5, categoryPercentage: 0.9,
                    datalabels: { color: 'white', font: {size: 14, weight:'bold', family:'Poppins'}, display: (ctx)=>ctx.dataset.data[ctx.dataIndex]>0 }
                },
                {
                    label: 'Insuficiente', data: dataFail, backgroundColor: '#C62828', barPercentage: 0.5, categoryPercentage: 0.9,
                    datalabels: { color: 'white', font: {size: 14, weight:'bold', family:'Poppins'}, display: (ctx)=>ctx.dataset.data[ctx.dataIndex]>0, formatter: (val) => val }
                }
            ]
        },
        options: {
            indexAxis: 'y', responsive: true, maintainAspectRatio: false,
            scales: { x: { stacked: true, grid: {color: gridColor}, ticks: {color:txtColor, font:{family:'Poppins', weight:'600'}} }, y: { stacked: true, grid: {display:false}, ticks: { color:txtColor, font:{size:12, weight:'bold', family:'Poppins'}, autoSkip: false } } },
            plugins: {
                title: { display: true, text: 'Dias com meta satisfatória x Dias com meta insuficiente', color: txtColor, font: {size: 16, weight: '700', family:'Poppins'}, align: 'start', padding: {bottom: 15} },
                legend: { labels: {color:txtColor, font:{family:'Poppins', weight:'600'}} }, tooltip: { mode: 'index', intersect: true }, customLabels: { }
            }
        },
        plugins: [{
            id: 'customLabels',
            afterDatasetsDraw: (chart) => {
                const { ctx } = chart;
                ctx.save(); ctx.font = Chart.helpers.fontString(12, 'bold', 'Poppins'); ctx.fillStyle = txtColor; ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
                const meta = chart.getDatasetMeta(1);
                meta.data.forEach((bar, index) => {
                    let ok = dataOk[index]; let fail = dataFail[index]; let total = ok + fail;
                    let percent = total > 0 ? Math.round((ok / total) * 100) + '%' : '0%';
                    let ofName = labels[index]; let missingCount = (window.tempMissingDataP3[ofName] || []).length;
                    let text = percent; if(missingCount > 0) text += `  (SR: ${missingCount} dias)`;
                    ctx.fillText(text, bar.x + 8, bar.y);
                });
                ctx.restore();
            }
        }]
    });
  }

  function setupDemanda() {
    globalDemandas = [...new Set(rawData.map(r => r.item).filter(Boolean))].sort();
    let sel = document.getElementById('p4Demanda'); let currentVal = sel.value;
    sel.innerHTML = '';
    let optsContainer = document.getElementById('demandaOptionsContainer'); optsContainer.innerHTML = '';

    if (globalDemandas.length > 0) {
        if (!globalDemandas.includes(currentVal)) currentVal = globalDemandas[0];
        sel.value = currentVal;
        document.getElementById('demandaSelectedText').innerText = currentVal;

        globalDemandas.forEach(d => {
            let o = document.createElement('option'); o.value = d; sel.appendChild(o);
            let optDiv = document.createElement('div'); optDiv.className = 'check-item'; optDiv.innerText = d;
            optDiv.onclick = (e) => { e.stopPropagation(); selectDemandaOption(d); };
            optsContainer.appendChild(optDiv);
        });
    } else { document.getElementById('demandaSelectedText').innerText = 'Nenhuma demanda'; }
    updateP4Pecas(); 
  }

  function toggleDemandaDropdown() {
    let content = document.getElementById('demandaDropdownContent');
    let isHidden = content.style.display === 'none' || content.style.display === '';
    if (isHidden) {
        content.style.display = 'flex';
        document.getElementById('demandaSearchInput').value = '';
        filterDemandaOptions(); 
        setTimeout(() => document.getElementById('demandaSearchInput').focus(), 50);
    } else { content.style.display = 'none'; }
  }

  function selectDemandaOption(val) {
    document.getElementById('demandaSelectedText').innerText = val; document.getElementById('p4Demanda').value = val; 
    document.getElementById('demandaDropdownContent').style.display = 'none';
    updateP4Pecas(); renderPage4();   
  }

  function filterDemandaOptions(e) {
    if (e) e.stopPropagation();
    let query = document.getElementById('demandaSearchInput').value.toLowerCase();
    let opts = document.querySelectorAll('#demandaOptionsContainer .check-item');
    opts.forEach(opt => {
        let text = opt.innerText.toLowerCase();
        if (text.includes(query)) opt.style.display = 'block'; else opt.style.display = 'none';
    });
  }

  document.addEventListener('click', function(event) {
    let dropdown = document.getElementById('demandaDropdown'); let content = document.getElementById('demandaDropdownContent');
    if (dropdown && content && !dropdown.contains(event.target)) { content.style.display = 'none'; }
  });

  function filterP4Pecas() {
    let query = document.getElementById('p4SearchPecas').value.toLowerCase();
    let labels = document.querySelectorAll('#p4PecasContainer .check-item');
    labels.forEach(label => {
      let text = label.innerText.toLowerCase();
      if(text.includes(query)) label.style.display = 'flex'; else label.style.display = 'none';
    });
  }

  function updateP4Pecas() {
    let searchInput = document.getElementById('p4SearchPecas');
    if(searchInput) searchInput.value = '';

    let dem = document.getElementById('p4Demanda').value;
    let demandRecords = rawData.filter(r => r.item === dem && r.tipo);
    let list = [...new Set(demandRecords.map(r => r.tipo))].sort();
    
    let cont = document.getElementById('p4PecasContainer'); cont.innerHTML = '';
    list.forEach(p => {
      let div = document.createElement('label'); div.className = 'check-item';
      div.innerHTML = `<input type="checkbox" value="${p}" onchange="renderPage4()"> ${p}`;
      cont.appendChild(div);
    });
    
    if(chartDemandaInst) { chartDemandaInst.destroy(); chartDemandaInst=null; }
    let sumEl = document.getElementById('p4Summary'); if(sumEl) sumEl.innerHTML = '';
    let bkEl = document.getElementById('p4OficinasBreakdown'); if(bkEl) bkEl.innerHTML = '';
  }

  function renderPage4() {
    let datesFilter = getFilterDates(); let dem = document.getElementById('p4Demanda').value;
    let checks = document.querySelectorAll('#p4PecasContainer input:checked'); let selPecas = Array.from(checks).map(c => c.value);
    let breakdownCont = document.getElementById('p4OficinasBreakdown');

    if(!selPecas.length) { 
      if(chartDemandaInst) { chartDemandaInst.destroy(); chartDemandaInst=null; } 
      document.getElementById('p4Summary').innerHTML = ''; breakdownCont.innerHTML = ''; return; 
    }

    let filtered = rawData.filter(r => r.dateObj >= datesFilter.start && r.dateObj <= datesFilter.end && r.item === dem && selPecas.includes(r.tipo));
    
    let totals = {}; selPecas.forEach(p => totals[p] = 0);
    filtered.forEach(r => totals[r.tipo] += r.producaoDia);
    
    let summaryHTML = '';
    selPecas.forEach(p => { summaryHTML += `<div style="background:var(--accent); color:white; padding:10px 15px; border-radius:12px; font-size:0.85rem; font-weight:600; box-shadow:var(--shadow);">${p}: ${totals[p]} un</div>`; });
    document.getElementById('p4Summary').innerHTML = summaryHTML;

    let dates = [...new Set(filtered.map(r => r.data))].sort((a,b)=>{
       let da=a.split('/'), db=b.split('/'); return new Date(da[2],da[1]-1,da[0]) - new Date(db[2],db[1]-1,db[0]);
    });

    let datasets = selPecas.map((peca, i) => {
       let colors = ['#1565C0', '#42A5F5', '#1E88E5', '#64B5F6', '#90CAF9']; let c = colors[i % colors.length];
       let data = dates.map(d => {
         let rs = filtered.filter(x => x.data === d && x.tipo === peca);
         if (rs.length === 0 && isDateWeekend(d)) return null; 
         return rs.reduce((a,b)=>a+b.producaoDia, 0) || 0;
       });
       return { label: peca, data: data, borderColor: c, backgroundColor: c, tension: 0.3, pointRadius: 4, borderWidth: 2, spanGaps: true };
    });

    let ctx = document.getElementById('chartDemanda').getContext('2d');
    if(chartDemandaInst) chartDemandaInst.destroy();
    let gridColor = getComputedStyle(document.body).getPropertyValue('--chart-grid').trim(); 
    let txtColor = getComputedStyle(document.body).getPropertyValue('--text-muted').trim();

    chartDemandaInst = new Chart(ctx, {
      type: 'line',
      data: { labels: dates, datasets: datasets },
      options: {
        responsive: true, maintainAspectRatio: false,
        scales: { y: { grid: {color:gridColor}, ticks:{color:txtColor, font:{family:'Poppins', weight:'600'}} }, x: { grid:{display:false}, ticks:{color:txtColor, font:{family:'Poppins', weight:'600'}} } },
        plugins: { legend: { labels: { color: txtColor, font:{family:'Poppins', weight:'600'} } }, datalabels: { display: 'auto', color: txtColor, anchor:'end', align:'top', offset:2, formatter: (val) => val === null ? '' : val, font:{family:'Poppins', weight:'bold'} } }
      }
    });

    let oficinaTotals = {};
    filtered.forEach(r => {
      if(!oficinaTotals[r.oficina]) oficinaTotals[r.oficina] = {};
      if(!oficinaTotals[r.oficina][r.tipo]) oficinaTotals[r.oficina][r.tipo] = 0;
      oficinaTotals[r.oficina][r.tipo] += r.producaoDia;
      if(!oficinaTotals[r.oficina]['_total']) oficinaTotals[r.oficina]['_total'] = 0;
      oficinaTotals[r.oficina]['_total'] += r.producaoDia;
    });

    if(Object.keys(oficinaTotals).length === 0) { breakdownCont.innerHTML = ''; return; }

    let breakdownHtml = '<h4 style="margin-top:0; color:var(--text-main); font-size:1rem; margin-bottom:15px; text-transform:uppercase; font-weight:800;">Produção por Oficina (Peças Selecionadas)</h4><div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap:15px;">';
    let sortedOficinas = Object.keys(oficinaTotals).sort((a,b) => oficinaTotals[b]['_total'] - oficinaTotals[a]['_total']);
    
    sortedOficinas.forEach(of => {
       breakdownHtml += `<div style="background:var(--input-bg); padding:15px; border-radius:12px; border:1px solid var(--border-color);"><div style="font-weight:800; color:var(--accent); font-size:0.95rem; margin-bottom:10px; text-transform:uppercase;">${of}</div>`;
       selPecas.forEach(p => {
          if(oficinaTotals[of][p] > 0) {
              breakdownHtml += `<div style="display:flex; justify-content:space-between; font-size:0.85rem; color:var(--text-muted); border-bottom:1px dashed var(--border-color); padding:4px 0;"><span>${p}</span> <span style="font-weight:700; color:var(--text-main);">${oficinaTotals[of][p]}</span></div>`;
          }
       });
       breakdownHtml += `<div style="display:flex; justify-content:space-between; font-size:0.9rem; font-weight:800; margin-top:8px;"><span>TOTAL</span> <span style="color:var(--accent);">${oficinaTotals[of]['_total']}</span></div></div>`;
    });
    breakdownHtml += '</div>'; breakdownCont.innerHTML = breakdownHtml;
  }
</script>