<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <link rel="icon" type="image/png" href="/images/logo.png">
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
    
    <style>
      /* PADRÃO GLOBAL: Textos Fluidos */
      .texto-fluido { word-break: normal !important; overflow-wrap: normal !important; hyphens: none !important; white-space: normal !important; font-size: clamp(0.7rem, 2.5vw, 0.9rem) !important; line-height: 1.2 !important; }
      .numero-fluido { white-space: nowrap !important; word-break: keep-all !important; overflow-wrap: normal !important; font-size: clamp(0.65rem, 3vw, 1.1rem) !important; }

      :root {
        --bg-color: #f8fafc; 
        --card-bg: #ffffff; 
        --sidebar-bg: #001E7A;
        --text-main: #1e293b; 
        --text-muted: #64748b; 
        --accent: #001E7A; 
        --accent-dark: #001557;
        --accent-light: #e0e7ff;
        --border-color: #e2e8f0; 
        --input-bg: #f1f5f9;
        --shadow: 0 2px 5px rgba(0,0,0,0.05);
        
        --success: #1b5e20; --success-bg: #e8f5e9;
        --warning: #e65100; --warning-bg: #fff3e0; --warning-text-dark: #e65100;
        --danger: #b71c1c; --danger-bg: #ffebee;
        --neutral: #424242; --neutral-bg: #f5f5f5;
        --table-row-hover: #fcfdfe;
        --chart-grid: #e2e8f0;
      }

      body.dark-mode {
        --bg-color: #121416; --card-bg: #1c2126; --sidebar-bg: #1c2126;
        --text-main: #f0f2f5; --text-muted: #a0abb5;
        --accent: #b0bec5; --accent-dark: #78909c;
        --accent-light: #23292e;
        --border-color: #2a3138; --input-bg: #23292e;
        --shadow: 0 10px 30px rgba(0,0,0,0.3);
        --chart-grid: #333333;
        --success-bg: rgba(46, 125, 50, 0.2); --warning-bg: rgba(255, 152, 0, 0.1); --danger-bg: rgba(198, 40, 40, 0.2);
        --table-row-hover: #2a3138;
      }

      html, body { background-color: var(--bg-color); color: var(--text-main); font-family: 'Poppins', sans-serif; transition: 0.3s; margin: 0; padding: 0; max-width: 100vw; overflow-x: hidden; }
      * { box-sizing: border-box; }

      /* BORDAS PADRÃO SERRALHERIA */
      .top-bar, .slide-header, .chart-card, .new-card, .flash-box { border-radius: 20px !important; border: none !important; box-shadow: var(--shadow) !important; background: var(--card-bg); }
      button, .theme-btn, .drop-btn, .fc-button, .summary-card { border-radius: 8px !important; transition: all 0.2s ease-in-out !important; }

      .layout-wrapper { display: flex; min-height: 100vh; position: relative; width: 100%; max-width: 100vw; overflow-x: hidden; }
      
      /* SIDEBAR NOVA */
      .sidebar-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); z-index: 90; backdrop-filter: blur(2px); }
      .sidebar-overlay.show { display: block; }
      .sidebar { width: 320px; position: fixed; left: 0; top: 0; bottom: 0; background: var(--sidebar-bg); border-right: 1px solid var(--border-color); display: flex; flex-direction: column; align-items: flex-start; padding-top: 25px; gap: 10px; z-index: 1000; overflow-x: hidden; white-space: nowrap; transition: left 0.3s; }
      
      .nav-item { width: calc(100% - 40px); margin: 0 20px; height: 54px; border-radius: 14px; display: flex; align-items: center; justify-content: flex-start; padding-left: 15px; color: #ffffff; cursor: pointer; transition: 0.3s all ease; border: none; text-decoration: none; background: transparent;}
      .nav-item:hover { background: rgba(255, 255, 255, 0.1); color: #ffffff; }
      .nav-item.active { background: #ffffff !important; color: var(--sidebar-bg) !important; box-shadow: 0 6px 15px rgba(0, 0, 0, 0.25); }
      .nav-item .material-icons { font-size: 28px; min-width: 34px; } 
      .nav-text { margin-left: 15px; font-size: 1.05rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px; }

      .main-content { flex: 1; overflow-y: auto; padding: 30px; position: relative; margin-left: 320px; width: calc(100vw - 320px); transition: margin-left 0.3s, width 0.3s; overflow-x: hidden; }
      
      .top-bar { padding: 15px 25px; margin-bottom: 30px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 15px; }
      .title-box { display: flex; align-items: center; gap: 10px; }
      .title-box h1 { margin: 0; font-size: 1.6rem; font-weight: 700; color: var(--text-main); text-transform: uppercase; } 
      
      .date-filters { display: flex; gap: 10px; background: var(--input-bg); padding: 10px 15px; border-radius: 14px; border: 1px solid transparent; } 
      .date-filters input { border: none; background: transparent; color: var(--text-main); outline: none; cursor: pointer; font-family: inherit; font-size: 0.95rem; font-weight: 500; width: 130px;} 
      
      .theme-btn { cursor: pointer; background: transparent; border: 1px solid var(--border-color); padding: 0.8rem 1.2rem !important; border-radius: 14px; color: var(--text-muted); display:flex; align-items:center; justify-content:center;}
      .theme-btn:hover { background: var(--accent) !important; color: white !important; }
      .clock-display { font-size: 1.2rem; font-weight: 700; color: var(--accent); background: var(--input-bg); padding: 8px 16px; border-radius: 14px; display: flex; align-items: center; gap: 8px; }

      .slide-header { background: var(--card-bg); padding: 20px 25px; border-radius: 20px; margin-bottom: 25px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap:15px; border: none; box-shadow: var(--shadow); }
      .slide-title { font-size: 1.4rem; color: var(--text-main); font-weight: 700; display: flex; align-items: center; gap: 12px; text-transform: uppercase; margin: 0;} 
      .slide-title .material-icons { color: var(--accent); font-size: 28px; }

      .page { display: none; animation: fadeEffect 0.4s ease; }
      .page.active { display: block; }
      @keyframes fadeEffect { from {opacity: 0; transform: translateY(10px);} to {opacity: 1; transform: translateY(0);} }

      .st-badge, .pill, .nc-pill { padding: 6px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; border: none; display:inline-block; text-align:center;}
      .ok, .st-ok, .st-verde { background: var(--success-bg) !important; color: var(--success) !important; }
      .fail, .st-bad, .st-vermelho { background: var(--danger-bg) !important; color: var(--danger) !important; }
      .warn, .st-amarelo { background: var(--warning-bg) !important; color: var(--warning-text-dark) !important; }
      .neutral, .st-none, .st-arquivado { background: var(--input-bg) !important; color: var(--text-muted) !important; }
      .insumo { background: var(--warning-bg) !important; color: var(--warning-text-dark) !important; }

      /* Loader Animado */
      #loader { position: fixed; inset: 0; background: var(--bg-color); z-index: 9999; display: flex; flex-direction: column; align-items: center; justify-content: center; transition: opacity 0.5s ease-out; }
      .spinner { width: 60px; height: 60px; border: 5px solid var(--border-color); border-top: 5px solid var(--accent); border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 20px;}
      @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
      body.loaded #loader { opacity: 0; pointer-events: none; }

      /* DROPDOWN NOVO PADRÃO */
      .custom-dropdown { position: relative; display: inline-block; flex: 1; min-width: 150px;}
      .drop-btn { background: var(--card-bg); border: 1px solid var(--border-color); padding: 12px 18px; border-radius: 12px !important; cursor: pointer; font-size: 0.95rem; color: var(--text-main); font-weight: 500; display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; transition: 0.2s;}
      .drop-btn:hover { border-color: var(--accent); color: var(--accent); }
      .dropdown-content { display: none; position: absolute; top: 110%; left: 0; background-color: var(--card-bg); min-width: 100%; width: max-content; max-width: 90vw; box-shadow: var(--shadow); z-index: 1000; border: 1px solid var(--border-color); border-radius: 16px; padding: 10px; max-height: 250px; overflow-y: auto; }
      .dropdown-content.show { display: block; animation: fadeEffect 0.2s; }
      .dropdown-search { width: 100%; padding: 10px; margin-bottom: 8px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem; background: var(--input-bg); color: var(--text-main); outline: none; }
      .check-item { display: flex; align-items: center; padding: 8px; cursor: pointer; font-size: 0.9rem; color: var(--text-main); border-radius: 4px; transition: 0.2s; border-bottom: none;}
      .check-item:hover { background-color: var(--input-bg); }
      .check-item input { margin-right: 10px; accent-color: var(--accent); width: 16px; height: 16px; }

      /* MODAL GENÉRICO */
      .modal { display: none; position: fixed; z-index: 2000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.5); animation: fadeEffect 0.3s; }
      .modal-content { background-color: var(--card-bg); margin: 10% auto; padding: 25px; border: 1px solid var(--border-color); width: 400px; max-width: 90%; border-radius: 20px; box-shadow: var(--shadow); position: relative; color: var(--text-main); }
      .close { color: var(--text-muted); float: right; font-size: 28px; font-weight: bold; cursor: pointer; }
      .close:hover { color: var(--danger); }
      #modalList { max-height: 300px; overflow-y: auto; margin-top: 15px; }
      .modal-item { padding: 8px 0; border-bottom: 1px dashed var(--border-color); font-size: 14px; }

      /* AVISO DE PAINEL ANTIGO */
      .old-panel-banner { background: var(--warning-bg); color: var(--warning-text-dark); border: 1px solid var(--warning-text-dark); padding: 15px 20px; border-radius: 12px; margin-bottom: 25px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; box-shadow: var(--shadow); }
      .old-panel-banner .msg { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 14px; }
      .btn-novo-painel { background: var(--accent); color: #ffffff; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 14px; display: flex; align-items: center; gap: 8px; transition: 0.2s; border: none; }
      .btn-novo-painel:hover { filter: brightness(1.2); color: #ffffff; }

      /* NOTIFICAÇÕES & WHATSAPP (OVERLAY SERRALHERIA) */
      .notif-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); backdrop-filter: blur(2px); z-index: 10500; display: none; align-items: center; justify-content: center; animation: fadeEffect 0.3s; }
      .notif-box { background: var(--card-bg); width: 95%; max-width: 600px; max-height: 85vh; border-radius: 20px; display: flex; flex-direction: column; box-shadow: 0 15px 50px rgba(0,0,0,0.5); overflow: hidden; border: 1px solid var(--border-color); color: var(--text-main); }
      .notif-header { padding: 20px; background: var(--accent); color: #fff; display: flex; justify-content: space-between; align-items: center; }
      .notif-header h5 { margin: 0; font-size: 1.1rem; font-weight: 700; display: flex; align-items: center; gap: 10px;}
      .notif-close { cursor: pointer; background: none; border: none; color: white; font-size: 24px; transition: 0.2s; }
      .notif-close:hover { transform: scale(1.1); color: var(--danger); }
      .notif-body { padding: 20px; overflow-y: auto; flex: 1; }
      .notif-footer { padding: 15px 20px; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 10px; background: var(--input-bg); }
      
      .notif-item { border: 1px solid var(--border-color); border-radius: 12px; overflow: hidden; margin-bottom: 12px; }
      .notif-item-header { padding: 15px; background: var(--input-bg); cursor: pointer; transition: background 0.2s; }
      .notif-item-header:hover { filter: brightness(0.95); }
      .notif-item-header .header-row-1 { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;}
      .notif-item-header .header-row-2 { display: flex; justify-content: space-between; align-items: center; font-size: 13px;}
      .notif-item-header .material-icons { transition: transform 0.3s; color: var(--text-muted); }
      .notif-item-header.expanded .material-icons { transform: rotate(180deg); }
      .notif-item-body { display: none; padding: 15px; border-top: 1px solid var(--border-color); background: var(--card-bg); }
      .notif-item-body.show { display: block; }
      .notif-item-list { list-style: none; padding: 0; margin: 0; }
      .notif-item-list li { background: var(--input-bg); padding: 8px 12px; border-radius: 6px; margin-bottom: 5px; display: flex; justify-content: space-between; align-items: center; font-size: 13px; border: 1px dashed var(--border-color); }
      
      .btn-notif { padding: 10px 15px; border-radius: 8px; font-weight: 600; cursor: pointer; border: none; font-size: 14px; display: flex; align-items: center; gap: 8px; transition: 0.2s;}
      .btn-notif-sec { background: var(--input-bg); color: var(--text-main); border: 1px solid var(--border-color); }
      .btn-notif-sec:hover { background: var(--border-color); }
      .btn-notif-pri { background: #4CAF50; color: white; }
      .btn-notif-pri:hover { background: #388E3C; }

      /* MOBILE */
      #mobile-menu-btn { display: none; background: transparent; border: 1px solid var(--border-color); color: var(--text-main); border-radius: 12px; padding: 5px 10px; cursor: pointer; }
      @media (max-width: 1199px) { 
        .sidebar { left: -320px; }
        .sidebar.open { left: 0; }
        .main-content { margin-left: 0; width: 100vw; padding: 15px; }
        .clock-display { display: none; } 
        .top-bar { flex-direction: column; align-items: flex-start; }
        .top-bar > div:last-child {width: 100%; flex-wrap: wrap !important; justify-content: space-between;}
        #mobile-menu-btn { display: block; }
      }
    </style>
  </head>
  <body>

    <div id="loader"><div class="spinner"></div><div style="font-weight: 700; color: var(--text-muted); font-size: 1.2rem;">CARREGANDO...</div></div>

    <div class="layout-wrapper">
      <div class="sidebar-overlay" id="sidebar-overlay" onclick="toggleSidebar()"></div>
      
      <div class="sidebar" id="sidebar">
        <div style="width: 100%; display: flex; justify-content: center; align-items: center; padding-bottom: 20px; margin-bottom: 5px; border-bottom: 1px solid var(--border-color); position:relative;">
           <img src="/images/logo.png" alt="Logo" style="height: 100px; max-width: 85%; object-fit: contain;">
           <div style="position: absolute; top: 10px; right: 15px; cursor: pointer; display: flex; align-items: center;" onclick="openNotifications()" title="Entregas da Semana" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'" style="transition: transform 0.2s;">
               <span class="material-icons" style="font-size: 26px; color: #ffffff;">notifications</span>
               <span id="notifBadge" style="display:none; position: absolute; top: -5px; right: -5px; background: #E53935; color: white; font-size: 10px; font-weight: bold; width: 16px; height: 16px; border-radius: 50%; text-align: center; line-height: 16px; border: 2px solid var(--sidebar-bg);">0</span>
           </div>
        </div>
        
        <div class="nav-item active" onclick="showPage('page1')" title="Diário de Produção"><span class="material-icons">today</span><span class="nav-text">DIÁRIO</span></div>
        <div class="nav-item" onclick="showPage('pageOficina')" title="Relatório da Oficina"><span class="material-icons">store</span><span class="nav-text">OFICINA</span></div>
        <div class="nav-item" onclick="showPage('page2')" title="Desempenho"><span class="material-icons">show_chart</span><span class="nav-text">DESEMPENHO</span></div>
        <div class="nav-item" onclick="showPage('page3')" title="Detalhes"><span class="material-icons">list_alt</span><span class="nav-text">DETALHES</span></div>
        <div class="nav-item" onclick="showPage('page4')" title="Demanda"><span class="material-icons">analytics</span><span class="nav-text">DEMANDA</span></div>
        <div class="nav-item" onclick="showPage('page5')" title="Processos"><span class="material-icons">inventory_2</span><span class="nav-text">PROCESSOS</span></div>
        <div class="nav-item" onclick="showPage('page6')" title="Cronograma"><span class="material-icons">calendar_month</span><span class="nav-text">CRONOGRAMA</span></div>
        <div class="nav-item" onclick="showPage('page7')" title="Fardamento Interno"><span class="material-icons">checkroom</span><span class="nav-text">FARD. INTERNO</span></div>
        <div class="nav-item" onclick="showPage('page8')" title="Fardamento Servidor"><span class="material-icons">badge</span><span class="nav-text">FARD. SEAP</span></div>
      </div>
      
      <div class="main-content">
        <div class="top-bar" id="topBarGlobal">
          <div class="title-box">
            <button id="mobile-menu-btn" onclick="toggleSidebar()"><i class="material-icons">menu</i></button>
            <h1>DASHBOARD - MALHARIA</h1>
          </div>
          <div style="display:flex; gap:15px; align-items:center; width: 100%; justify-content: flex-end;">
            <button class="theme-btn" onclick="refreshDashboard()" title="Atualizar Dados" style="font-weight: 700; color: var(--accent);"><span class="material-icons" style="margin-right: 5px;">sync</span> ATUALIZAR</button>
            <div class="date-filters"><input type="date" id="globalStart" onchange="updateAll()"><input type="date" id="globalEnd" onchange="updateAll()"></div>
            <div class="clock-display" title="Hora atual"><span class="material-icons" style="font-size:22px;">schedule</span><span id="lastUpdate" style="font-variant-numeric: tabular-nums; min-width: 80px; text-align: center; display: inline-block;">--:--:--</span></div>
            <button class="theme-btn" onclick="toggleDarkMode()" title="Alternar Modo Noturno"><span class="material-icons" id="modeIcon">dark_mode</span></button>
          </div>
        </div>

        <div class="old-panel-banner">
          <div class="msg"><span class="material-icons" style="font-size: 24px;">warning_amber</span> Aviso: Este é o painel antigo. Um novo painel já está disponível.</div>
          <a href="https://malhariaseap.com/publico" target="_blank" class="btn-novo-painel">Ir para o Novo Painel <span class="material-icons" style="font-size: 18px;">arrow_forward</span></a>
        </div>

        <%- include('partials/main') %>
        <div id="pageOficina" class="page"><%- include('partials/oficina') %></div>
        <div id="page5" class="page"><%- include('partials/processos') %></div>
        <div id="page6" class="page"><%- include('partials/cronograma') %></div>
        <div id="page7" class="page"><%- include('partials/fardamento') %></div>
        <div id="page8" class="page"><%- include('partials/fardamentoseap') %></div>
      </div>
    </div>
    
    <div class="notif-overlay" id="notifOverlay">
        <div class="notif-box">
            <div class="notif-header">
                <h5><span class="material-icons">event</span> Entregas Pendentes da Semana</h5>
                <button type="button" class="notif-close" onclick="closeNotifications()">&times;</button>
            </div>
            <div class="notif-body" id="notifBody">
                <div style="text-align: center; padding: 40px; color: var(--text-muted);"><span class="material-icons" style="font-size: 40px; animation: spin 1s infinite linear;">refresh</span><div style="margin-top: 10px;">Carregando demandas...</div></div>
            </div>
            <div class="notif-footer">
                <button class="btn-notif btn-notif-sec" onclick="closeNotifications()">Fechar</button>
                <button class="btn-notif btn-notif-pri" id="btnCopyNotif" onclick="copyWhatsAppText()"><i class="bi bi-whatsapp" style="font-size: 16px; margin-right: 6px;"></i> Copiar para WhatsApp</button>
            </div>
        </div>
    </div>

    <div class="notif-overlay" id="whatsOverlay">
        <div class="notif-box">
            <div class="notif-header" style="background: #128C7E;">
                <h5><i class="bi bi-whatsapp" style="margin-right: 8px;"></i> Pré-visualização do Relatório</h5>
                <button type="button" class="notif-close" onclick="closeWhatsModal()">&times;</button>
            </div>
            <div class="notif-body">
                <textarea id="whatsTextarea" style="width: 100%; height: 300px; border: 1px solid var(--border-color); border-radius: 8px; padding: 10px; font-family: monospace; background: var(--input-bg); color: var(--text-main); resize: none;" readonly></textarea>
            </div>
            <div class="notif-footer">
                <button class="btn-notif btn-notif-sec" onclick="closeWhatsModal()">Fechar</button>
                <button class="btn-notif btn-notif-pri" id="btnCopyWhats" onclick="copyWhatsText()"><i class="bi bi-whatsapp" style="font-size: 16px; margin-right: 6px;"></i> Copiar Texto</button>
            </div>
        </div>
    </div>

    <script>
      function toggleSidebar() {
          const sb = document.querySelector('.sidebar');
          const over = document.getElementById('sidebar-overlay');
          if(sb.classList.contains('open')) {
              sb.classList.remove('open');
              over.classList.remove('show');
          } else {
              sb.classList.add('open');
              over.classList.add('show');
          }
      }

      function toggleDarkMode() {
        document.body.classList.toggle('dark-mode');
        let isDark = document.body.classList.contains('dark-mode');
        document.getElementById('modeIcon').innerText = isDark ? 'light_mode' : 'dark_mode';
        if(typeof updateAll === 'function') updateAll(); 
      }
      
      function showPage(pid) {
        document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
        document.querySelectorAll('.nav-item').forEach(b=>b.classList.remove('active'));
        document.getElementById(pid).classList.add('active');
        event.currentTarget.classList.add('active');
        
        if (window.innerWidth <= 1199) { toggleSidebar(); }

        if(pid === 'page1' && typeof renderPage1 === 'function') renderPage1();
        if(pid === 'pageOficina' && typeof renderPageOficina === 'function') renderPageOficina();
        if(pid === 'page2' && typeof renderPage2 === 'function') renderPage2();
        if(pid === 'page3' && typeof renderPage3 === 'function') renderPage3();
        if(pid === 'page4' && typeof renderPage4 === 'function') renderPage4();
        if(pid === 'page5' && typeof renderPage5 === 'function') renderPage5();
        if(pid === 'page6' && typeof initCronograma === 'function') initCronograma();
        if(pid === 'page7' && typeof initFardamento === 'function') initFardamento();
        if(pid === 'page8' && typeof initFardamentoSeap === 'function') initFardamentoSeap();
      }
      
      function startClock() {
        const clockElement = document.getElementById('lastUpdate');
        if (clockElement) clockElement.innerHTML = new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      }
      setInterval(startClock, 1000);

      function getThemeColor(variable) { return getComputedStyle(document.body).getPropertyValue(variable).trim(); }
      function refreshDashboard() { window.location.href = '/?refresh=true'; }

      function openWhatsModal(text) {
          document.getElementById('whatsTextarea').value = text;
          document.getElementById('whatsOverlay').style.display = 'flex';
      }
      function closeWhatsModal() { document.getElementById('whatsOverlay').style.display = 'none'; }
      function copyWhatsText() {
          const text = document.getElementById('whatsTextarea').value;
          navigator.clipboard.writeText(text).then(() => {
              const btn = document.getElementById('btnCopyWhats');
              const origHtml = btn.innerHTML;
              btn.innerHTML = '<i class="bi bi-check-lg" style="font-size: 16px; margin-right: 6px;"></i> Copiado!';
              btn.classList.remove('btn-notif-pri');
              btn.style.background = 'var(--input-bg)';
              btn.style.color = '#4CAF50';
              btn.style.border = '1px solid #4CAF50';
              setTimeout(() => {
                  btn.innerHTML = origHtml;
                  btn.classList.add('btn-notif-pri');
                  btn.style = '';
              }, 2500);
          });
      }
      
      const INITIAL_DATA = <%- INITIAL_DATA %>;
    </script>
  </body>
</html>